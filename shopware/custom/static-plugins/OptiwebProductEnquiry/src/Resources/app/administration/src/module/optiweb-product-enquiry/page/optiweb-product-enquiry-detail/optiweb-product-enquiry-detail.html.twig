{% block optiweb_product_enquiry_detail %}
<sw-page class="optiweb-product-enquiry-detail">
    {% block optiweb_product_enquiry_detail_header %}
    <template #smart-bar-header>
        <h2>{{ $t('optiwebProductEnquiry.admin.detail.title') }}</h2>
    </template>
    {% endblock %}

    {% block optiweb_product_enquiry_detail_actions %}
    <template #smart-bar-actions>
        <mt-button variant="secondary" @click="goBack">{{ $t('global.default.cancel') }}</mt-button>
        <mt-button
            v-if="enquiry && enquiry.status === 'new'"
            variant="primary"
            :is-loading="isSaving"
            @click="markAsRead"
        >
            {{ $t('optiwebProductEnquiry.admin.detail.markAsRead') }}
        </mt-button>
    </template>
    {% endblock %}

    {% block optiweb_product_enquiry_detail_content %}
    <template #content>
        <mt-loader v-if="isLoading" />
        <template v-else-if="enquiry">
            <mt-card
                position-identifier="optiweb-product-enquiry-detail-customer"
                :title="$t('optiwebProductEnquiry.admin.detail.customerSection')"
            >
                <sw-container columns="1fr 1fr" gap="16px">
                    <mt-text-field :model-value="enquiry.firstName" :label="$t('account.personalFirstName')" disabled />
                    <mt-text-field :model-value="enquiry.lastName" :label="$t('account.personalLastName')" disabled />
                    <mt-text-field :model-value="enquiry.email" :label="$t('account.personalMailLabel')" disabled />
                    <mt-text-field :model-value="enquiry.phone || '—'" :label="$t('account.profilePhoneNumber')" disabled />
                </sw-container>
            </mt-card>

            <mt-card
                position-identifier="optiweb-product-enquiry-detail-products"
                :title="$t('optiwebProductEnquiry.admin.detail.productSection')"
            >
                <sw-data-grid
                    :dataSource="productLines"
                    :columns="productColumns"
                    :showSelection="false"
                    :showActions="false"
                    :compactMode="true"
                    plainAppearance
                />
            </mt-card>

            <mt-card
                v-if="enquiry.message"
                position-identifier="optiweb-product-enquiry-detail-message"
                :title="$t('optiwebProductEnquiry.admin.detail.messageSection')"
            >
                <mt-textarea :model-value="enquiry.message" disabled />
            </mt-card>

            <mt-card
                position-identifier="optiweb-product-enquiry-detail-meta"
                title="Meta"
            >
                <sw-container columns="1fr 1fr" gap="16px">
                    <mt-text-field
                        :model-value="formattedCreatedAt"
                        label="Submitted"
                        disabled
                    />
                    <div>
                        <label>Status</label>
                        <sw-label :variant="enquiry.status === 'new' ? 'warning' : 'success'" appearance="pill">
                            {{ $t('optiwebProductEnquiry.admin.detail.status.' + enquiry.status) }}
                        </sw-label>
                    </div>
                </sw-container>
            </mt-card>
        </template>
    </template>
    {% endblock %}
</sw-page>
{% endblock %}
