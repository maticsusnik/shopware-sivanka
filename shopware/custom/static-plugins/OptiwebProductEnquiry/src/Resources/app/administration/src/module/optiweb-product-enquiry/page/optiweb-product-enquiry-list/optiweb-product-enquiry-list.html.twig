{% block optiweb_product_enquiry_list %}
<sw-page
    class="optiweb-product-enquiry-list"
    :class="{ 'is--editing': isEditing }"
>
    {% block optiweb_product_enquiry_list_header %}
    <template #smart-bar-header>
        <h2>{{ $t('optiwebProductEnquiry.admin.list.title') }}</h2>
    </template>
    {% endblock %}

    {% block optiweb_product_enquiry_list_search %}
    <template #smart-bar-actions>
        <sw-simple-search-field
            v-model:value="searchTerm"
            @search-term-change="onSearch"
        />
        <template v-if="isEditing">
            <mt-button variant="secondary" :disabled="isSaving" @click="onCancelEdit">
                {{ $t('global.default.cancel') }}
            </mt-button>
            <sw-button-process
                variant="primary"
                :is-loading="isSaving"
                :process-success="isSaveSuccessful"
                @update:process-success="saveFinish"
                @click.prevent="onSave"
            >
                {{ $t('global.default.save') }}
            </sw-button-process>
        </template>
        <mt-button v-else variant="primary" :disabled="isLoading" @click="onEdit">
            {{ $t('global.default.edit') }}
        </mt-button>
    </template>
    {% endblock %}

    {% block optiweb_product_enquiry_list_content %}
    <template #content>
        <sw-data-grid
            ref="grid"
            :data-source="enquiries"
            :columns="columns"
            :is-loading="isLoading"
            :sort-by="sortBy"
            :sort-direction="sortDirection"
            :show-actions="true"
            :show-selection="true"
            :rows-clickable="!isEditing"
            :item-identifier-property="'id'"
            identifier="optiweb-product-enquiry-list"
            @row-click="onRowClick"
            @column-sort="onColumnSort"
            @selection-change="onSelectionChange"
        >
            {# Only editable after Edit; the change is written by Save #}
            <template #column-status="{ item }">
                <mt-checkbox
                    class="optiweb-product-enquiry-list__done"
                    :checked="isDone(item)"
                    :disabled="!isEditing || isSaving"
                    @update:checked="onToggleDone(item, $event)"
                />
            </template>
            <template #column-createdAt="{ item }">
                <span :class="{ 'optiweb-product-enquiry-list__muted': isDone(item) }">{{ formatDate(item.createdAt) }}</span>
            </template>
            <template #column-firstName="{ item }">
                <span :class="{ 'optiweb-product-enquiry-list__muted': isDone(item) }">{{ item.firstName }} {{ item.lastName }}</span>
            </template>
            <template #column-email="{ item }">
                <span :class="{ 'optiweb-product-enquiry-list__muted': isDone(item) }">{{ item.email }}</span>
            </template>
            <template #column-productName="{ item }">
                <span :class="{ 'optiweb-product-enquiry-list__muted': isDone(item) }">{{ item.productName }}</span>
                <sw-label
                    v-if="item.productCount > 1"
                    appearance="pill"
                    size="small"
                >
                    {{ $t('optiwebProductEnquiry.admin.list.moreProducts', { count: item.productCount - 1 }, item.productCount - 1) }}
                </sw-label>
            </template>
            <template #column-quantity="{ item }">
                <template v-if="item.productCount > 1">&mdash;</template>
                <template v-else>{{ item.quantity }}</template>
            </template>

            <template #bulk>
                <a
                    class="link link-danger"
                    role="button"
                    tabindex="0"
                    @click="onDelete(Object.keys(selection))"
                    @keydown.enter="onDelete(Object.keys(selection))"
                >
                    {{ $t('global.default.delete') }}
                </a>
            </template>

            <template #actions="{ item }">
                <sw-context-menu-item @click="onRowClick(item)">
                    {{ $t('global.default.view') }}
                </sw-context-menu-item>
                <sw-context-menu-item @click="setDone(item, !isDone(item))">
                    {{ isDone(item) ? $t('optiwebProductEnquiry.admin.markNotDone') : $t('optiwebProductEnquiry.admin.markDone') }}
                </sw-context-menu-item>
                <sw-context-menu-item variant="danger" @click="onDelete([item.id])">
                    {{ $t('global.default.delete') }}
                </sw-context-menu-item>
            </template>

            <template #pagination>
                <sw-pagination
                    :page="page"
                    :limit="limit"
                    :total="total"
                    :total-visible="7"
                    @page-change="onPageChange"
                />
            </template>
        </sw-data-grid>

        <sw-modal
            v-if="deleteIds"
            :title="$t('global.default.warning')"
            variant="small"
            @modal-close="onCloseDeleteModal"
        >
            <p>{{ $t('optiwebProductEnquiry.admin.deleteConfirm', { count: deleteIds.length }, deleteIds.length) }}</p>

            <template #modal-footer>
                <mt-button size="small" variant="secondary" @click="onCloseDeleteModal">
                    {{ $t('global.default.cancel') }}
                </mt-button>
                <mt-button size="small" variant="critical" @click="onConfirmDelete">
                    {{ $t('global.default.delete') }}
                </mt-button>
            </template>
        </sw-modal>
    </template>
    {% endblock %}
</sw-page>
{% endblock %}
