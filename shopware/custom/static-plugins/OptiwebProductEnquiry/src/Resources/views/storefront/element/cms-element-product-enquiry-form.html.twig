{% block element_form %}
    {% set config = element.fieldConfig.elements %}

    <div class="cms-element-{{ element.type }}" data-optiweb-product-enquiry>
        <div class="row">
            {% set formViolations = app.request.get('errors') %}
            {% if element.config.type.value is same as('product-enquiry') %}
                <div class="col-md-12 body">
                    {% block element_form_product_enquiry_form_form %}
                        {% sw_include '@Storefront/storefront/element/cms-element-form/form-types/product-enquiry-form.html.twig'
                            with {
                            action: 'frontend.form.product-enquiry.send',
                            submitText: 'optiwebProductEnquiry.form.submit'
                        } %}
                    {% endblock %}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
