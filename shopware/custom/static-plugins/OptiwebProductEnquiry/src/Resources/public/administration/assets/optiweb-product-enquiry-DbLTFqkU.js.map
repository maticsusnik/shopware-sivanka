{% block optiweb_product_enquiry_detail %}
<sw-page class="optiweb-product-enquiry-detail">
    {% block optiweb_product_enquiry_detail_header %}
    <template #smart-bar-header>
        <h2>
            {{ $t('optiwebProductEnquiry.admin.detail.title') }}
            <sw-label v-if="isDone" variant="success" appearance="pill" size="small">
                {{ $t('optiwebProductEnquiry.admin.detail.status.done') }}
            </sw-label>
        </h2>
    </template>
    {% endblock %}

    {% block optiweb_product_enquiry_detail_actions %}
    <template #smart-bar-actions>
        <mt-button variant="secondary" @click="goBack">{{ $t('global.default.cancel') }}</mt-button>
        <mt-button
            v-if="enquiry"
            variant="critical"
            ghost
            :disabled="isSaving"
            @click="showDeleteModal = true"
        >
            {{ $t('global.default.delete') }}
        </mt-button>
        <mt-button
            v-if="enquiry"
            :variant="isDone ? 'secondary' : 'primary'"
            :is-loading="isSaving"
            @click="toggleDone"
        >
            {{ isDone ? $t('optiwebProductEnquiry.admin.markNotDone') : $t('optiwebProductEnquiry.admin.markDone') }}
        </mt-button>
    </template>
    {% endblock %}

    {% block optiweb_product_enquiry_detail_content %}
    <template #content>
        <mt-loader v-if="isLoading" />
        <template v-else-if="enquiry">
            <mt-card
                position-identifier="optiweb-product-enquiry-detail-customer"
                :title="$t('optiwebProductEnquiry.admin.detail.customerSection')"
            >
                <sw-container columns="1fr 1fr" gap="16px">
                    <mt-text-field :model-value="enquiry.firstName" :label="$t('optiwebProductEnquiry.admin.detail.firstName')" disabled />
                    <mt-text-field :model-value="enquiry.lastName" :label="$t('optiwebProductEnquiry.admin.detail.lastName')" disabled />
                    <mt-text-field :model-value="enquiry.email" :label="$t('optiwebProductEnquiry.admin.detail.email')" disabled />
                    <mt-text-field :model-value="enquiry.phone || '—'" :label="$t('optiwebProductEnquiry.admin.detail.phone')" disabled />
                </sw-container>
            </mt-card>

            <mt-card
                position-identifier="optiweb-product-enquiry-detail-products"
                :title="$t('optiwebProductEnquiry.admin.detail.productSection')"
            >
                <sw-data-grid
                    :dataSource="productLines"
                    :columns="productColumns"
                    :showSelection="false"
                    :showActions="false"
                    :compactMode="true"
                    plainAppearance
                />
            </mt-card>

            <mt-card
                v-if="enquiry.message"
                position-identifier="optiweb-product-enquiry-detail-message"
                :title="$t('optiwebProductEnquiry.admin.detail.messageSection')"
            >
                <mt-textarea :model-value="enquiry.message" disabled />
            </mt-card>

            <mt-card
                position-identifier="optiweb-product-enquiry-detail-meta"
                :title="$t('optiwebProductEnquiry.admin.detail.metaSection')"
            >
                <mt-text-field
                    :model-value="formattedCreatedAt"
                    :label="$t('optiwebProductEnquiry.admin.detail.submitted')"
                    disabled
                />
            </mt-card>
        </template>

        <sw-modal
            v-if="showDeleteModal"
            :title="$t('global.default.warning')"
            variant="small"
            @modal-close="showDeleteModal = false"
        >
            <p>{{ $t('optiwebProductEnquiry.admin.deleteConfirm', { count: 1 }, 1) }}</p>

            <template #modal-footer>
                <mt-button size="small" variant="secondary" @click="showDeleteModal = false">
                    {{ $t('global.default.cancel') }}
                </mt-button>
                <mt-button size="small" variant="critical" @click="onConfirmDelete">
                    {{ $t('global.default.delete') }}
                </mt-button>
            </template>
        </sw-modal>
    </template>
    {% endblock %}
</sw-page>
{% endblock %}
