<div class="sw-field sw-block-field sw-field--textarea sw-field--default">
    <div v-if="label" class="sw-field__label">
        {{ label }}
    </div>
    <div class="sw-block-field__block-multifield">
        <div class="ow-layout">
            <div class="ow-layout__two">
                <mt-select label="Link type" v-model="linkType" :options="linkSelector"/>
            </div>
            <div class="ow-layout__four" v-if="linkType == LINK_TYPE_EXTERNAL">
                <mt-text-field label="Button URL" v-model="linkExternal"></mt-text-field>
            </div>
        </div>
        <div v-if="linkType == LINK_TYPE_INTERNAL" class="sw-block-field__block-multifield">
            <mt-select label="Select link type" v-model="linkInternal.entity" @change="selectLinkTypeEvent"
                       :options="internalLinkSelector"/>
            <div v-if="linkInternal.entity == ENTITY_TYPE_CATEGORY">
                <sw-entity-single-select entity="category" v-model:value="linkInternal.value" label="Select Category"/>
            </div>
            <div v-if="linkInternal.entity == ENTITY_TYPE_PRODUCT">
                <sw-entity-single-select entity="product" v-model:value="linkInternal.value" label="Select Product"/>
            </div>
        </div>
        <mt-text-field label="Button text" v-model="text"></mt-text-field>
    </div>
</div>
