{% block sw_cms_element_main_slider_config %}
    <div class="optiweb-main-slider-config">
        <mt-tabs
            :key="tabItems.length"
            :items="tabItems"
            :default-item="tabItems[activeSlide] ? tabItems[activeSlide].name : ''"
            @new-item-active="onTabChange"
        />
        <div v-for="(slide, index) in computedSlides">
            <div v-if="index === activeSlide">

                <sw-number-field numberType="int" :digits="0" label="Order" :copyable="false"
                                 v-model="element.config.slides.value[index].order"
                                 :copyableTooltip="false">
                </sw-number-field>

                <sw-text-field label="Title" :copyable="false" v-model="element.config.slides.value[index].title"
                               :copyableTooltip="false">
                </sw-text-field>

                <sw-text-field label="Text" :copyable="false"
                               v-model="element.config.slides.value[index].text"
                               :copyableTooltip="false">
                </sw-text-field>

                <ow-url v-model="element.config.slides.value[index].button" label="Button" @input="(newValue) => handleButtonInput(index, newValue)"></ow-url>

                <sw-textarea-field label="Description" :copyable="false"
                                   v-model="element.config.slides.value[index].description"
                                   :copyableTooltip="false">
                </sw-textarea-field>

                {% block sw_cms_element_image_config_media_upload %}
                    <sw-cms-mapping-field
                            v-model:config="element.config.slides.value[index].image"
                            :label="$tc('sw-cms.elements.image.label')"
                            value-types="entity"
                            entity="media"
                    >
                        <sw-media-upload-v2
                                variant="regular"
                                :upload-tag="uploadTag"
                                :source="previewSource(index)"
                                :allow-multi-select="false"
                                :default-folder="cmsPageState.pageEntityName"
                                :caption="$tc('sw-cms.elements.general.config.caption.mediaUpload')"
                                @media-upload-sidebar-open="onOpenMediaModal"
                                @media-upload-remove-image="onImageRemove(index)"
                        />

{#                        <template #preview="{ demoValue }">#}
{#                            <div class="sw-cms-el-config-image__mapping-preview">#}
{#                                <img#}
{#                                        v-if="demoValue.url"#}
{#                                        :src="demoValue.url"#}
{#                                        alt=""#}
{#                                >#}
{#                                <mt-banner#}
{#                                        v-else#}
{#                                        class="sw-cms-el-config-image__preview-info"#}
{#                                        variant="info"#}
{#                                >#}
{#                                    {{ $tc('sw-cms.detail.label.mappingEmptyPreview') }}#}
{#                                </mt-banner>#}
{#                            </div>#}
{#                        </template>#}
                    </sw-cms-mapping-field>

                    <sw-upload-listener
                            :upload-tag="uploadTag"
                            auto-upload
                            @media-upload-finish="(item) => onImageUpload(item,index)"
                    />
                {% endblock %}

                {% block sw_cms_element_image_config_media_modal %}
                    <sw-media-modal-v2
                            v-if="mediaModalIsOpen"
                            variant="full"
                            :caption="$tc('sw-cms.elements.general.config.caption.mediaUpload')"
                            :entity-context="cmsPageState.entityName"
                            :allow-multi-select="false"
                            :initial-folder-id="cmsPageState.defaultMediaFolderId"
                            @media-upload-remove-image="onImageRemove(index)"
                            @media-modal-selection-change="(selection) => onSelectionChanges(selection, index)"
                            @modal-close="onCloseModal"
                    />
                {% endblock %}

                <div style="padding-top:32px; border-top:1px solid; margin-top:32px" class="remove">
                    <mt-button  variant="critical" @click="removeSlide(index)">
                        Remove this slide
                    </mt-button>
                </div>
            </div>
        </div>
        <div style="margin-top:32px">
            <mt-button variant="primary" @click="createNewSlide" >
                Add new slide
            </mt-button>
        </div>
    </div>
{% endblock %}
