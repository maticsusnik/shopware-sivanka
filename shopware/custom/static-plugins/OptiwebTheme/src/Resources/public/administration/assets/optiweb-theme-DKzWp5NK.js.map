{% block sw_cms_block_img_text %}
    <div class="sw-cms-block-img-text">
        <div :class="['sw-cms-block-img-text__inner', layoutClass]">
        <div class="sw-cms-block-img-text__image">
                <slot name="image"></slot>
            </div>
            <div class="sw-cms-block-img-text__content">
                <slot name="content"></slot>
            </div>
        </div>
    </div>
{% endblock %}
