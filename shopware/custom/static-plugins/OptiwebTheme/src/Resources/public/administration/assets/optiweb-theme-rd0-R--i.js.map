{% block sw_cms_el_config_sivanka_hero %}
<div class="sw-cms-el-config-sivanka-hero">
    <sw-media-field label="Background Image" :allowEmpty="true"
        v-model:value="element.config.backgroundImage.value"
        @update:value="onUpdate" />

    <sw-text-field label="Headline" v-model="element.config.headline.value" @change="onUpdate" />
    <sw-text-field label="Headline emphasis (italic, pink)" v-model="element.config.headlineEmphasis.value" @change="onUpdate" />
    <sw-textarea-field label="Subheadline" v-model="element.config.subheadline.value" @change="onUpdate" />

    <sw-text-field label="Primary button label" v-model="element.config.primaryBtnLabel.value" @change="onUpdate" />
    <ow-url label="Primary button URL" v-model="element.config.primaryBtnUrl.value" @change="onUpdate" />
    <sw-text-field label="Secondary button label" v-model="element.config.secondaryBtnLabel.value" @change="onUpdate" />
    <ow-url label="Secondary button URL" v-model="element.config.secondaryBtnUrl.value" @change="onUpdate" />

    <sw-container columns="repeat(3,1fr)" gap="16px">
        <div>
            <p><strong>Trust item 1</strong></p>
            <sw-single-select label="Icon" :options="iconOptions" v-model:value="element.config.trust1Icon.value" @update:value="onUpdate" />
            <sw-text-field label="Title" v-model="element.config.trust1Title.value" @change="onUpdate" />
            <sw-text-field label="Subtitle" v-model="element.config.trust1Sub.value" @change="onUpdate" />
        </div>
        <div>
            <p><strong>Trust item 2</strong></p>
            <sw-single-select label="Icon" :options="iconOptions" v-model:value="element.config.trust2Icon.value" @update:value="onUpdate" />
            <sw-text-field label="Title" v-model="element.config.trust2Title.value" @change="onUpdate" />
            <sw-text-field label="Subtitle" v-model="element.config.trust2Sub.value" @change="onUpdate" />
        </div>
        <div>
            <p><strong>Trust item 3</strong></p>
            <sw-single-select label="Icon" :options="iconOptions" v-model:value="element.config.trust3Icon.value" @update:value="onUpdate" />
            <sw-text-field label="Title" v-model="element.config.trust3Title.value" @change="onUpdate" />
            <sw-text-field label="Subtitle" v-model="element.config.trust3Sub.value" @change="onUpdate" />
        </div>
    </sw-container>
</div>
{% endblock %}
