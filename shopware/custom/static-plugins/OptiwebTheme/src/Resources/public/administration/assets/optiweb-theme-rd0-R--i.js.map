{% block sw_cms_el_config_sivanka_service_card %}
<div class="sw-cms-el-config-sivanka-service-card">
    {% block sw_cms_el_config_sivanka_service_card_media %}
    <sw-media-upload-v2
        variant="regular"
        :upload-tag="uploadTag"
        :source="previewSource"
        :allow-multi-select="false"
        :default-folder="cmsPageState.pageEntityName"
        :label="$tc('sw-cms.elements.sivankaServiceCard.config.label.media')"
        :caption="$tc('sw-cms.elements.general.config.caption.mediaUpload')"
        @media-upload-sidebar-open="onOpenMediaModal"
        @media-upload-remove-image="onImageRemove"
    />

    <sw-upload-listener
        :upload-tag="uploadTag"
        auto-upload
        @media-upload-finish="onImageUpload"
    />
    {% endblock %}

    {% block sw_cms_el_config_sivanka_service_card_icon %}
    <mt-select
        v-model="element.config.icon.value"
        :label="$tc('sw-cms.elements.sivankaServiceCard.config.label.icon')"
        :options="iconOptions"
        @update:model-value="onChange"
    />
    {% endblock %}

    {% block sw_cms_el_config_sivanka_service_card_title %}
    <mt-text-field
        v-model="element.config.title.value"
        :label="$tc('sw-cms.elements.sivankaServiceCard.config.label.title')"
        @update:model-value="onChange"
    />
    {% endblock %}

    {% block sw_cms_el_config_sivanka_service_card_text %}
    <mt-textarea
        v-model="element.config.text.value"
        :label="$tc('sw-cms.elements.sivankaServiceCard.config.label.text')"
        :help-text="$tc('sw-cms.elements.sivankaServiceCard.config.helpText.text')"
        @update:model-value="onChange"
    />
    {% endblock %}

    {% block sw_cms_el_config_sivanka_service_card_url %}
    <div class="sw-cms-el-config-sivanka-service-card__url">
        <div class="sw-field__label">
            {{ $tc('sw-cms.elements.sivankaServiceCard.config.label.url') }}
        </div>
        <sw-dynamic-url-field
            v-model:value="element.config.url.value"
            @update:value="onChange"
        />
    </div>
    {% endblock %}

    {% block sw_cms_el_config_sivanka_service_card_link_label %}
    <mt-text-field
        v-model="element.config.linkLabel.value"
        :label="$tc('sw-cms.elements.sivankaServiceCard.config.label.linkLabel')"
        @update:model-value="onChange"
    />
    {% endblock %}

    {% block sw_cms_el_config_sivanka_service_card_variant %}
    <mt-select
        v-model="element.config.variant.value"
        :label="$tc('sw-cms.elements.sivankaServiceCard.config.label.variant')"
        :help-text="$tc('sw-cms.elements.sivankaServiceCard.config.helpText.variant')"
        :options="variantOptions"
        @update:model-value="onChange"
    />
    {% endblock %}

    {% block sw_cms_el_config_sivanka_service_card_media_modal %}
    <sw-media-modal-v2
        v-if="mediaModalIsOpen"
        variant="full"
        :caption="$tc('sw-cms.elements.general.config.caption.mediaUpload')"
        :entity-context="cmsPageState.entityName"
        :allow-multi-select="false"
        :initial-folder-id="cmsPageState.defaultMediaFolderId"
        @media-upload-remove-image="onImageRemove"
        @media-modal-selection-change="onSelectionChanges"
        @modal-close="onCloseMediaModal"
    />
    {% endblock %}
</div>
{% endblock %}
