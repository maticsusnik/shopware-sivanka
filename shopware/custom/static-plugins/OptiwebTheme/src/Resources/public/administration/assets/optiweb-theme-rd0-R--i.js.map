{% block sw_cms_el_sivanka_hero %}
<div class="sw-cms-el-sivanka-hero">
    <div class="sw-cms-el-sivanka-hero__box">
        <div class="sw-cms-el-sivanka-hero__text">
            <h2>{{ element.config.headline.value }} <em>{{ element.config.headlineEmphasis.value }}</em></h2>
            <p v-if="element.config.subheadline.value">{{ element.config.subheadline.value }}</p>
            <div class="sw-cms-el-sivanka-hero__btns">
                <span class="sw-cms-el-sivanka-hero__btn-primary" v-if="element.config.primaryBtnLabel.value">{{ element.config.primaryBtnLabel.value }}</span>
                <span class="sw-cms-el-sivanka-hero__btn-outline" v-if="element.config.secondaryBtnLabel.value">{{ element.config.secondaryBtnLabel.value }}</span>
            </div>
        </div>
    </div>
</div>
{% endblock %}
