{% block sw_cms_el_sivanka_icon_card %}
<div class="sw-cms-el-sivanka-icon-card" :class="'is--' + element.config.variant.value">
    <span
        v-if="iconLabel"
        class="sw-cms-el-sivanka-icon-card__icon"
    >{{ iconLabel }}</span>
    <div class="sw-cms-el-sivanka-icon-card__body">
        <p class="sw-cms-el-sivanka-icon-card__title">{{ element.config.title.value }}</p>
        <p v-if="element.config.text.value" class="sw-cms-el-sivanka-icon-card__text">
            {{ element.config.text.value }}
        </p>
    </div>
</div>
{% endblock %}
