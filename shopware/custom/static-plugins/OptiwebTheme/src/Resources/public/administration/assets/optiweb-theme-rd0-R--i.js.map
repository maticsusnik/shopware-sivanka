{% block sw_cms_el_sivanka_product_slider %}
    <div class="sw-cms-el-sivanka-product-slider">
        <div class="sw-cms-el-sivanka-product-slider__title" v-if="element.config.title.value && element.config.title.value.text">
            {{ element.config.title.value.text }}
        </div>
        <div class="sw-cms-el-sivanka-product-slider__placeholder">
            Product slider preview
        </div>
    </div>
{% endblock %}




