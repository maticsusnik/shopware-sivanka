{% sw_extends '@Storefront/storefront/layout/navbar/categories.html.twig' %}

{% block layout_navbar_categories %}
    {% set navigationMaxDepth = 3 %}

    {% if not level %}
        {% set level = 0 %}
    {% endif %}

    <div class="navigation-flyout-categories is-level-{{ level }}">
        {% for treeItem in navigationTree %}
            {% set category = treeItem.category %}
            {% set id = category.id %}
            {% set name = category.translated.name %}
            {% set link = category_url(category) %}

            {% set icon = category.extensions.navigationIcon ?? null %}

            {% block layout_navbar_categories_item %}
                <div class="navigation-flyout-col">

                    {% block layout_navbar_categories_item_link %}
                        {% if category.type == 'folder' %}
                            <div class="nav-item nav-item-{{ id }} nav-link nav-item-{{ id }}-link navigation-flyout-link is-level-{{ level }}"
                                 title="{{ name }}">
                                {% if level <= 4 and icon.url %}
                                    <span class="navigation-icon">
                                        <img src="{{ icon.url }}" alt="{{ icon.alt ?? category.name ~ ' menu icon' }}">
                                    </span>
                                {% endif %}
                                <span itemprop="name">{{ name }}</span>
                                {% if treeItem.children and level < navigationMaxDepth %}
                                    <span class="link-icon">
                                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M11.3538 8.35378L6.35378 13.3538C6.30733 13.4002 6.25218 13.4371 6.19148 13.4622C6.13079 13.4874 6.06573 13.5003 6.00003 13.5003C5.93434 13.5003 5.86928 13.4874 5.80859 13.4622C5.74789 13.4371 5.69274 13.4002 5.64628 13.3538C5.59983 13.3073 5.56298 13.2522 5.53784 13.1915C5.5127 13.1308 5.49976 13.0657 5.49976 13C5.49976 12.9343 5.5127 12.8693 5.53784 12.8086C5.56298 12.7479 5.59983 12.6927 5.64628 12.6463L10.2932 8.00003L5.64628 3.35378C5.55246 3.25996 5.49976 3.13272 5.49976 3.00003C5.49976 2.86735 5.55246 2.7401 5.64628 2.64628C5.7401 2.55246 5.86735 2.49976 6.00003 2.49976C6.13272 2.49976 6.25996 2.55246 6.35378 2.64628L11.3538 7.64628C11.4003 7.69272 11.4372 7.74786 11.4623 7.80856C11.4875 7.86926 11.5004 7.93433 11.5004 8.00003C11.5004 8.06574 11.4875 8.13081 11.4623 8.1915C11.4372 8.2522 11.4003 8.30735 11.3538 8.35378Z" fill="black"></path>
                                        </svg>
                                    </span>
                                {% endif %}
                            </div>
                        {% else %}
                            <a class="nav-item nav-item-{{ id }} nav-link nav-item-{{ id }}-link navigation-flyout-link is-level-{{ level }}"
                               href="{{ link }}"
                               itemprop="url"
                               {% if category.shouldOpenInNewTab %}target="_blank"
                               {% if category.linkType == 'external' %}rel="noopener noreferrer"{% endif %}
                               {% endif %}
                               title="{{ name }}">
                                {% if level <= 4 and icon.url %}
                                    <span class="navigation-icon">
                                        <img src="{{ icon.url }}" alt="{{ icon.alt ?? category.name ~ ' menu icon' }}">
                                    </span>
                                {% endif %}
                                <span itemprop="name">{{ name }}</span>

                                {% if treeItem.children and level < navigationMaxDepth %}
                                    <span class="link-icon">
                                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M11.3538 8.35378L6.35378 13.3538C6.30733 13.4002 6.25218 13.4371 6.19148 13.4622C6.13079 13.4874 6.06573 13.5003 6.00003 13.5003C5.93434 13.5003 5.86928 13.4874 5.80859 13.4622C5.74789 13.4371 5.69274 13.4002 5.64628 13.3538C5.59983 13.3073 5.56298 13.2522 5.53784 13.1915C5.5127 13.1308 5.49976 13.0657 5.49976 13C5.49976 12.9343 5.5127 12.8693 5.53784 12.8086C5.56298 12.7479 5.59983 12.6927 5.64628 12.6463L10.2932 8.00003L5.64628 3.35378C5.55246 3.25996 5.49976 3.13272 5.49976 3.00003C5.49976 2.86735 5.55246 2.7401 5.64628 2.64628C5.7401 2.55246 5.86735 2.49976 6.00003 2.49976C6.13272 2.49976 6.25996 2.55246 6.35378 2.64628L11.3538 7.64628C11.4003 7.69272 11.4372 7.74786 11.4623 7.80856C11.4875 7.86926 11.5004 7.93433 11.5004 8.00003C11.5004 8.06574 11.4875 8.13081 11.4623 8.1915C11.4372 8.2522 11.4003 8.30735 11.3538 8.35378Z" fill="black"></path>
                                        </svg>
                                    </span>
                                {% endif %}
                            </a>
                        {% endif %}
                    {% endblock %}

                    {% block layout_navbar_categories_recoursion %}
                        {{ parent() }}
                    {% endblock %}
                </div>
            {% endblock %}
        {% endfor %}
    </div>
{% endblock %}
