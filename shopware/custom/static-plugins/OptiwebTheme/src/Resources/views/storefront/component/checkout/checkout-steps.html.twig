{# Parameters: activeStep = 1 (cart) | 2 (checkout) | 3 (complete) #}
{% if activeStep is not defined %}{% set activeStep = 1 %}{% endif %}

<nav class="checkout-steps" aria-label="{{ 'checkout.stepsLabel'|trans|striptags }}">
    <ol class="checkout-steps-list">
        <li class="checkout-steps-item{% if activeStep > 1 %} is-done{% endif %}{% if activeStep == 1 %} is-active{% endif %}">
            {% if activeStep > 1 %}
                <a href="{{ path('frontend.checkout.cart.page') }}" class="checkout-steps-link">
            {% else %}
                <span class="checkout-steps-link">
            {% endif %}
                <span class="checkout-steps-number">1</span>
                <span class="checkout-steps-label">{{ 'optiweb.checkout.stepCart'|trans|sw_sanitize }}</span>
            {% if activeStep > 1 %}
                </a>
            {% else %}
                </span>
            {% endif %}
            <span class="checkout-steps-connector" aria-hidden="true"></span>
        </li>

        <li class="checkout-steps-item{% if activeStep > 2 %} is-done{% endif %}{% if activeStep == 2 %} is-active{% endif %}">
            <span class="checkout-steps-link">
                <span class="checkout-steps-number">2</span>
                <span class="checkout-steps-label">{{ 'optiweb.checkout.stepCheckout'|trans|sw_sanitize }}</span>
            </span>
            <span class="checkout-steps-connector" aria-hidden="true"></span>
        </li>

        <li class="checkout-steps-item{% if activeStep == 3 %} is-active{% endif %}">
            <span class="checkout-steps-link">
                <span class="checkout-steps-number">3</span>
                <span class="checkout-steps-label">{{ 'optiweb.checkout.stepComplete'|trans|sw_sanitize }}</span>
            </span>
        </li>
    </ol>
</nav>
