{% block element_faq %}
    {# Callers may pass the slot in as `element` (the newer blocks do) or rely on the
       block's own `content` / `faq` slot (the legacy category block does). #}
    {% set faqElement = element|default(null) %}
    {% if faqElement is null and block is defined %}
        {% set faqElement = block.slots.getSlot('content') ?: block.slots.getSlot('faq') %}
    {% endif %}
    {% set faqValues = faqElement ? faqElement.fieldConfig.elements.faq.value : null %}
    {% if faqValues %}
        {% set faqSchemaItems = [] %}
        <div class="ow-faq">
            <div class="ow-faq__wrapper">
                {% for key, question in faqValues %}
                    <div class="ow-faq__single">
                        <h5 class="ow-faq__single-question">
                            <span class="ow-faq__single-question-text">{{ question.question }}</span>
                            <span class="ow-faq__single-question-icon">
                            {% sw_icon 'caret-down' style { pack: 'ow'} %}
                        </span>
                        </h5>
                        <p class="ow-faq__single-answer">{{ question.answer }}</p>
                    </div>
                    {# Google rejects a Question with an empty name or answer text #}
                    {% if (question.question ?? '')|trim and (question.answer ?? '')|trim %}
                        {% set faqSchemaItems = faqSchemaItems|merge([{
                            '@type': 'Question',
                            name: question.question|trim,
                            acceptedAnswer: { '@type': 'Answer', text: question.answer|trim }
                        }]) %}
                    {% endif %}
                {% endfor %}
            </div>
        </div>
        {# json_encode, not string concatenation: the answer is a textarea, so a quote or a
           line break would otherwise make the JSON invalid and Google drops the whole
           FAQPage. HEX_TAG keeps an answer from closing the script element. #}
        {% block seo_faq_json %}
            {% if faqSchemaItems|length %}
                <script type="application/ld+json">
                    {{ { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqSchemaItems }|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_HEX_TAG'))|raw }}
                </script>
            {% endif %}
        {% endblock %}
    {% endif %}
{% endblock %}
