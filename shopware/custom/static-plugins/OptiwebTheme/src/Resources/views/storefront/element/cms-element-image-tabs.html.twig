{% block cms_element_image_tabs %}
    {% set contentElement = element.slots.getSlot('tabs') %}
    {% set tabs = contentElement.data.get("tabs") %}

    <div class="col-12 cms-element-image-tabs__inner" data-cms-element-id="{{ element.id }}">
        {% block cms_element_image_tabs_inner %}
            <h4 class="title has-line"><span>{{ contentElement.config.title.value }}</span></h4>
            <div class="row align-items-center image-tab-items justify-content-center justify-content-md-between flex-md-nowrap px-3">
            {% for tab in tabs %}
                {% if tab.image.id %}
                    <div class="col-6 col-sm-4 col-md-auto image-tab-item text-center">
                        {% sw_thumbnails 'cms-image-thumbnails' with {
                            media: tab.image,
                            sizes: {
                                'default': '150px'
                            }
                        } %}
                    </div>
                {% endif %}
            {% endfor %}
            </div>
        {% endblock %}
    </div>
{% endblock %}
