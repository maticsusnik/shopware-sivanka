{% sw_extends '@Storefront/storefront/component/line-item/type/product.html.twig' %}

{#
    Cart page: render the design's clean grid row.
    Offcanvas / confirm / order keep the default structure (handled by the
    inner-block overrides further down).
#}
{% block component_line_item_type_product %}
    {% if controllerAction is same as('cartPage') and displayMode == 'default' %}
        {% set productLink = seoUrl('frontend.detail.page', { productId: lineItem.referencedId }) %}
        <li class="{{ lineItemClasses }} sv-cart-line">
            <div class="sv-cart-product">
                <a href="{{ productLink }}" class="sv-cart-thumb" title="{{ label }}" tabindex="-1">
                    {% sw_include '@Storefront/storefront/component/line-item/element/image.html.twig' with {
                        lineItemLink: false,
                        fallbackIcon: 'placeholder'
                    } %}
                </a>
                <div class="sv-cart-meta">
                    <a href="{{ productLink }}" class="sv-cart-name">{{ label }}</a>

                    {% if lineItem.payload.options is not empty %}
                        {% sw_include '@Storefront/storefront/component/line-item/element/variant-characteristics.html.twig' %}
                    {% endif %}

                    {% if lineItem.payload.productNumber %}
                        <div class="sv-cart-sku">
                            {{ 'checkout.cartItemInfoId'|trans|sw_sanitize }} {{ lineItem.payload.productNumber }}
                        </div>
                    {% endif %}

                    <div class="sv-cart-unit">
                        {{ lineItem.price.unitPrice|currency }} / {{ 'checkout.lineItemUnitPriceDescriptor'|trans|sw_sanitize }}
                    </div>
                </div>
            </div>

            <div class="sv-cart-qty">
                {% sw_include '@Storefront/storefront/component/line-item/element/quantity.html.twig' %}
            </div>

            <div class="sv-cart-total">
                {% sw_include '@Storefront/storefront/component/line-item/element/total-price.html.twig' with {
                    currency: lineItem.order.currency.isoCode
                } %}
            </div>

            <div class="sv-cart-remove">
                {% if lineItem.removable and nestingLevel < 1 %}
                    {% sw_include '@Storefront/storefront/component/line-item/element/remove.html.twig' %}
                {% endif %}
            </div>
        </li>
    {% elseif controllerAction is same as('confirmPage') and displayMode == 'default' %}
        {% set productLink = seoUrl('frontend.detail.page', { productId: lineItem.referencedId }) %}
        <li class="{{ lineItemClasses }} sv-confirm-line">
            <div class="sv-confirm-thumb">
                {% sw_include '@Storefront/storefront/component/line-item/element/image.html.twig' with {
                    lineItemLink: false,
                    fallbackIcon: 'placeholder'
                } %}
            </div>
            <div class="sv-confirm-meta">
                <a href="{{ productLink }}" class="sv-confirm-name">{{ label }}</a>
                {% if lineItem.payload.options is not empty %}
                    {% sw_include '@Storefront/storefront/component/line-item/element/variant-characteristics.html.twig' %}
                {% endif %}
                <div class="sv-confirm-unit">
                    {{ lineItem.price.unitPrice|currency }} / {{ 'checkout.lineItemUnitPriceDescriptor'|trans|sw_sanitize }}
                </div>
            </div>
            <div class="sv-confirm-qty">
                {% sw_include '@Storefront/storefront/component/line-item/element/quantity.html.twig' %}
            </div>
            <div class="sv-confirm-total">
                {% sw_include '@Storefront/storefront/component/line-item/element/total-price.html.twig' with {
                    currency: lineItem.order.currency.isoCode
                } %}
            </div>
        </li>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{#
    The blocks below only apply on the parent() path (offcanvas / confirm),
    where the default multi-column row is used.
#}
{% block component_line_item_type_product_col_quantity %}
{% endblock %}

{% block component_line_item_type_product_col_unit_price %}
{% endblock %}

{% block component_line_item_type_product_col_remove %}
{% endblock %}

{% block component_line_item_type_product_details_container %}
    <div class="line-item-details-container">
        {% block component_line_item_type_product_label %}
            {{ parent() }}
        {% endblock %}

        {% if lineItem.payload.options is not empty %}
            {% block component_line_item_type_product_variant_characteristics %}
                {{ parent() }}
            {% endblock %}
        {% endif %}

        {% if lineItem.payload.features is not empty %}
            {% block component_line_item_type_product_features %}
                {{ parent() }}
            {% endblock %}
        {% endif %}

        {% block component_line_item_type_qty %}
            <div class="line-item-cart-quantity">
            {% sw_include '@Storefront/storefront/component/line-item/element/quantity.html.twig' %}
            </div>
        {% endblock %}

        <div class="line-item-total-price line-item-price checkout-price">
            {% sw_include '@Storefront/storefront/component/line-item/element/total-price.html.twig' with {
                currency: lineItem.order.currency.isoCode
            } %}
        </div>
    </div>
{% endblock %}

{% block component_line_item_type_product_col_total_price %}
    <div class="line-item-total-price line-item-price">
        {% if showRemoveButton and lineItem.removable and nestingLevel < 1 %}
            {% sw_include '@Storefront/storefront/component/line-item/element/remove.html.twig' %}
        {% endif %}
        {% sw_include '@Storefront/storefront/component/line-item/element/total-price.html.twig' with {
            currency: lineItem.order.currency.isoCode
        } %}
    </div>
{% endblock %}
