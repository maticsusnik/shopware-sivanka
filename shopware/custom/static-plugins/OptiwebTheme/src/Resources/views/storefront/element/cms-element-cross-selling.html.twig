{% sw_extends '@Storefront/storefront/element/cms-element-cross-selling.html.twig' %}

{# "Sorodni izdelki" — reference/Sivanka Product.dc.html.

   The reference draws a plain 4-up grid under a left-aligned section heading, not a
   slider: on a product page the row is short enough to show whole, and a rail there
   competes with the gallery for the same gesture.

   The products come from the product's own cross-selling when an editor has set one
   up in the administration; otherwise Core\Content\Product\SalesChannel\CrossSelling\
   FallbackCrossSellingRoute supplies four from the same category. #}
{% block cms_element_cross_selling_tabs_inner %}
    {% set groups = element.data.crossSellings.elements is defined
        ? element.data.crossSellings.elements|filter(item => item.total > 0 and item.crossSelling.active == true)
        : [] %}

    {% if groups|length %}
        <div class="product-detail-cross-selling sivanka-related">
            {% for item in groups %}
                {% set crossSelling = item.crossSelling %}

                <section class="sivanka-related__group">
                    {% if crossSelling.translated.name ?: crossSelling.name %}
                        <h2 class="sivanka-related__title">
                            {{ crossSelling.translated.name ?: crossSelling.name }}
                        </h2>
                    {% endif %}

                    <div class="sivanka-related__grid">
                        {% for product in item.products %}
                            <div class="sivanka-related__cell">
                                {% sw_include '@Storefront/storefront/component/product/card/box.html.twig' with {
                                    'layout': 'standard',
                                    'displayMode': 'cover',
                                } %}
                            </div>
                        {% endfor %}
                    </div>
                </section>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
