{% sw_extends '@Storefront/storefront/element/cms-element-cross-selling.html.twig' %}

{# "Sorodni izdelki" — reference/Sivanka Product.dc.html.

   Drawn as the same native horizontal rail the home page uses for "Pravkar prišlo"
   and "Najbolj priljubljeno" (`component/_rail.scss` + `sv-rail.plugin.js`): a flex
   track of fixed-width cards that swipes on touch and pages on the arrow pair. At
   1366 the 330px card still lands four across, so the reference's 4-up row survives
   on desktop while a phone gets a swipe instead of a four-card column.

   The products come from the product's own cross-selling when an editor has set one
   up in the administration; otherwise Core\Content\Product\SalesChannel\CrossSelling\
   FallbackCrossSellingRoute supplies four from the same category. #}
{% block cms_element_cross_selling_tabs_inner %}
    {% set groups = element.data.crossSellings.elements is defined
        ? element.data.crossSellings.elements|filter(item => item.total > 0 and item.crossSelling.active == true)
        : [] %}

    {% if groups|length %}
        <div class="product-detail-cross-selling sivanka-related">
            {% for item in groups %}
                {% set crossSelling = item.crossSelling %}
                {% set groupName = crossSelling.translated.name ?: crossSelling.name %}

                <section class="sivanka-related__group">
                    {% if groupName %}
                        <h2 class="sivanka-related__title">{{ groupName }}</h2>
                    {% endif %}

                    <div class="sv-rail sv-rail--products sivanka-related__rail"
                         data-sv-rail="true"
                         role="region"
                         aria-label="{{ groupName|striptags }}">
                        <div class="sv-rail__track" tabindex="0">
                            {% for product in item.products %}
                                <div class="sv-rail__item">
                                    {% sw_include '@Storefront/storefront/component/product/card/box.html.twig' with {
                                        'layout': 'standard',
                                        'displayMode': 'cover',
                                    } %}
                                </div>
                            {% endfor %}
                        </div>

                        {% sw_include '@Storefront/storefront/utilities/sivanka-rail-controls.html.twig' %}
                    </div>
                </section>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
