{% sw_extends '@Storefront/storefront/layout/header/header.html.twig' %}

{# Topbar is rendered full-width from the outer layout/header.html.twig — suppress here to avoid duplication #}
{% block layout_top_bar %}{% endblock %}

{% block layout_header_navigation %}
    <div class="row align-items-center g-0">
        {% block layout_header_logo %}
            <div class="col-2 header-logo-col">
                {% sw_include '@Storefront/storefront/layout/header/logo.html.twig' %}
            </div>
        {% endblock %}

        {# The reference keeps the search field visible at every width down to 340px,
           so there is no collapse and no magnifier toggle. Below 900 the header wraps
           and the field takes the second row. #}
        {% block layout_header_search %}
            <div class="col-12 order-2 col-sm order-sm-1 header-search-col">
                {% sw_include '@Storefront/storefront/layout/header/search.html.twig' %}
            </div>
        {% endblock %}

        {% block layout_header_actions %}
            <div class="col-auto order-1 col-sm-auto order-sm-2 header-actions-col">
                <div class="row g-0 align-items-center">

                    {% block layout_header_actions_account %}
                        {{ parent() }}
                    {% endblock %}

                    {% if config('core.cart.wishlistEnabled') %}
                        {% block layout_header_actions_wishlist %}
                            {{ parent() }}
                        {% endblock %}
                    {% endif %}

                    {% block layout_header_actions_cart %}
                        {{ parent() }}
                    {% endblock %}

                    {# Below $sv-bp-portrait this whole column becomes the fixed
                       bottom bar (see layout/_header.scss), and the menu opener joins
                       it as a fourth icon — the nav bar's own opener is hidden there.
                       Above it the reference draws three header icons and the opener
                       stays in the nav bar. #}
                    {% block layout_header_navigation_toggle %}
                        <div class="col-auto header-actions-menu">
                            <button type="button"
                                    class="btn header-actions-btn header-menu-btn"
                                    data-off-canvas-menu-mobile="true"
                                    aria-label="{{ 'general.menuLink'|trans|striptags }}">
                                {% sw_include '@Storefront/storefront/utilities/sivanka-icon.html.twig' with {
                                    sivankaIcon: 'menu',
                                    sivankaIconSize: 22
                                } only %}
                            </button>
                        </div>
                    {% endblock %}
                </div>
            </div>
        {% endblock %}
    </div>
{% endblock %}
