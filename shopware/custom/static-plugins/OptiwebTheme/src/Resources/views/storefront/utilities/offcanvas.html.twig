{% sw_extends '@Storefront/storefront/utilities/offcanvas.html.twig' %}

{% block utilities_offcanvas %}

    {{ parent() }}

    <div class="offcanvas-footer">
        {% sw_include '@Storefront/storefront/layout/navigation/offcanvas/footer-nav.html.twig' %}
    </div>
{% endblock %}

{# Core's close button is a full-width labelled btn-secondary, which does not belong in
   this design. It is replaced with the round icon button used everywhere else in the
   theme rather than dropped — the cart and account panels have no other way to close. #}
{% block utilities_offcanvas_close %}
    <button class="btn offcanvas-close ow-offcanvas-close js-offcanvas-close"
            type="button"
            aria-label="{{ 'general.offcanvasCloseMenu'|trans|striptags }}">
        {% sw_icon 'x' style { size: 'sm' } %}
    </button>
{% endblock %}
