{% sw_extends '@Storefront/storefront/component/shipping/shipping-method.html.twig' %}

{% block component_shipping_method_image %}
    {# Calculated by OptiwebTheme\Services\ShippingMethodRouteDecorator. #}
    {% set shippingPrice = shipping.extensions.optiwebShippingPrice.price|default(0) %}
    {% if (shippingPrice > 0) %}
        <div class="shipping-price">{{ shippingPrice|currency }}</div>
    {% else %}
        <div class="shipping-price">{{ 'optiweb.checkout.freeShipping'|trans }}</div>
    {% endif %}
{% endblock %}
