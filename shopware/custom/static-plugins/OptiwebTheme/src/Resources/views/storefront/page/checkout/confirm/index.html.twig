{% sw_extends '@Storefront/storefront/page/checkout/confirm/index.html.twig' %}

{#
    Three columns (PAM Viličar's checkout structure, Sivanka's look):
      1  Podatki plačnika     who orders, then the billing / shipping address cards
      2  Plačilo in dostava   payment and shipping forms, then the order note
      3  Povzetek naročila    rows, totals, terms and the submit button (core's aside, sticky)
    Below xl the summary drops under columns 1 + 2, below lg everything stacks.

    Only core's blocks move, every form and field name stays core's: the order note and the
    terms checkbox reach #confirmOrderForm through their `form` attribute, as in core.
    The grid itself is in scss/pages/checkout/_checkout-flow.scss (CONFIRM PAGE).
#}

{% block page_checkout_confirm_header %}
    <h1 class="confirm-main-header">
        {{ 'optiweb.checkout.title'|trans|sw_sanitize }}
    </h1>
{% endblock %}

{# TOS is relocated into the summary aside (checkbox stays bound via form="confirmOrderForm") #}
{# @deprecated core block (6.7 only) — removed in 6.8, the override is then simply unused #}
{% block page_checkout_confirm_tos %}{% endblock %}

{# 6.8: core renders its own TOS/revocation checkboxes here — the theme renders its own in
   page_checkout_aside_actions, so keep this empty to avoid duplicate id="tos"/"revocation" #}
{% block page_checkout_confirm_tos_auto_confirmed %}{% endblock %}

{% block page_checkout_confirm_address %}
    <div class="confirm-section confirm-section--address">
        <div class="confirm-section-header">
            <span class="confirm-section-number">1</span>
            <h2 class="confirm-section-title">{{ 'optiweb.checkout.stepCustomer'|trans|sw_sanitize }}</h2>
        </div>
        <p class="sv-step-customer">
            <strong>{{ context.customer.firstName }} {{ context.customer.lastName }}</strong>
            <span>{{ context.customer.email }}</span>
        </p>
        {{ parent() }}
    </div>
{% endblock %}

{% block page_checkout_confirm_payment_shipping %}
    <div class="confirm-section confirm-section--payment-shipping">
        <div class="confirm-section-header">
            <span class="confirm-section-number">2</span>
            <h2 class="confirm-section-title">{{ 'optiweb.checkout.stepPaymentShipping'|trans|sw_sanitize }}</h2>
        </div>
        {{ parent() }}

        {# The order note joins column 2 instead of core's own row under the main column #}
        {% if config('core.cart.showCustomerComment') %}
            <div class="checkout-additional">
                {{ block('page_checkout_finish_customer_comment') }}
            </div>
        {% endif %}
    </div>
{% endblock %}

{# Rendered in column 2 above #}
{% block page_checkout_additional %}{% endblock %}

{# The rows move into the summary column (page_checkout_summary_header below) #}
{% block page_checkout_confirm_product_table %}{% endblock %}

{% block page_checkout_summary_header %}
    <div class="confirm-section-header">
        <span class="confirm-section-number">3</span>
        <h2 class="confirm-section-title">{{ 'optiweb.checkout.confirmSummaryHeader'|trans|sw_sanitize }}</h2>
    </div>

    <div class="confirm-product">
        <ul class="list-unstyled">
            {% for lineItem in page.cart.lineItems %}
                {% block page_checkout_confirm_table_item %}
                    {% sw_include '@Storefront/storefront/component/line-item/line-item.html.twig' with {
                        redirectTo: 'frontend.checkout.confirm.page',
                        showTaxPrice: showTaxPrice,
                        showSubtotal: showSubtotal
                    } %}
                {% endblock %}
            {% endfor %}
        </ul>
    </div>
{% endblock %}

{% block page_checkout_aside_actions %}
    {# Terms of service — checkbox bound to the order form by id #}
    <label class="sv-confirm-tos" for="tos">
        <input type="checkbox"
               class="checkout-confirm-tos-checkbox form-check-input{% if formViolations.getViolations('/tos') is not empty %} is-invalid{% endif %}"
               required="required"
               id="tos"
               form="confirmOrderForm"
               name="tos">
        <span class="checkout-confirm-tos-label">
            {# Legal links open the real page in a new tab, see sivanka-legal-link #}
            {% import '@OptiwebTheme/storefront/utilities/sivanka-legal-link.html.twig' as legal %}
            {% set showLegalGuaranteeNotice = config('core.cart.showLegalGuaranteeNotice') %}
            {{ (showLegalGuaranteeNotice ? 'optiweb.checkout.confirmTermsTextWithGuarantee' : 'optiweb.checkout.confirmTermsText')|trans({
                '%tosModalTagOpen%': legal.open('core.basicInformation.tosPage', 'checkout-confirm-terms-modal'),
                '%tosModalTagClose%': legal.close('core.basicInformation.tosPage'),
                '%revocationModalTagOpen%': legal.open('core.basicInformation.revocationPage'),
                '%revocationModalTagClose%': legal.close('core.basicInformation.revocationPage'),
                '%privacyModalTagOpen%': legal.open('core.basicInformation.privacyPage'),
                '%privacyModalTagClose%': legal.close('core.basicInformation.privacyPage'),
                '%legalGuaranteeNoticeModalTagOpen%': '<button type="button" class="btn btn-link-inline" aria-haspopup="dialog" data-bs-toggle="modal" data-bs-target="#legalGuaranteeNoticeModal">',
                '%legalGuaranteeNoticeModalTagClose%': '</button>',
            })|raw }}
        </span>
    </label>

    {% if page.showRevocation() %}
        <label class="sv-confirm-tos" for="revocation">
            <input type="checkbox"
                   class="checkout-confirm-revocation-checkbox form-check-input{% if formViolations.getViolations('/revocation') is not empty %} is-invalid{% endif %}"
                   required="required"
                   id="revocation"
                   form="confirmOrderForm"
                   name="revocation">
            <span class="checkout-confirm-revocation-label">{{ 'checkout.confirmRevocationTerms'|trans() }}</span>
        </label>
    {% endif %}

    {# parent() still renders the legal guarantee notice modal (#legalGuaranteeNoticeModal) #}
    {{ parent() }}

    <div class="sv-ssl-note">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
        <span>{{ 'optiweb.checkout.sslSecure'|trans|sw_sanitize }}</span>
    </div>
{% endblock %}

{# Below the minimum order value the order cannot be placed (the server refuses it
   anyway); the warning above explains why, the button is switched off. #}
{% block page_checkout_confirm_form_submit %}
    {% import '@OptiwebTheme/storefront/utilities/sivanka-min-order-value.html.twig' as minOrder %}
    {% if minOrder.belowMinimum(page.cart, context)|trim is not empty %}
        <div class="d-grid">
            <button id="confirmFormSubmit"
                    class="btn btn-primary btn-lg"
                    form="confirmOrderForm"
                    disabled
                    type="submit">
                {{ 'checkout.confirmSubmit'|trans|sw_sanitize }}
            </button>
        </div>
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}
