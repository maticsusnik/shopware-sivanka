{# Inline SVG icon set for the Sivanka service (storitve) CMS elements.

   Usage:
       {% sw_include '@Storefront/storefront/utilities/sivanka-icon.html.twig' with {
           sivankaIcon: 'ruler',
           sivankaIconSize: 22
       } only %}

   The glyph inherits its color from `currentColor`. Keep the key list in sync with
   `Resources/app/administration/src/module/sw-cms/elements/sivanka-service-icons.js`. #}
{% block utilities_sivanka_icon %}
    {% set sivankaIconPaths = {
        'ruler': '<path d="M3 15L15 3l6 6L9 21z"/><path d="M7.5 10.5l2 2M10.5 7.5l2 2M13.5 4.5l2 2"/>',
        'calculator': '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 7h8M8 11h2M12 11h2M16 11h.01M8 15h2M12 15h2M16 15h.01M8 19h6"/>',
        'fabric': '<path d="M4 6c3-2 6-2 8 0s5 2 8 0v12c-3 2-5 2-8 0s-5-2-8 0z"/>',
        'home': '<path d="M4 10l8-6 8 6v10H4z"/><path d="M10 20v-6h4v6"/>',
        'shirt': '<path d="M8 4l4 3 4-3 4 3-2 3v11H6V10L4 7z"/>',
        'scissors': '<circle cx="6" cy="18" r="2.6"/><circle cx="18" cy="18" r="2.6"/><path d="M7.8 16.2L18 4M16.2 16.2L6 4"/>',
        'needle': '<path d="M4 20L18 6"/><circle cx="19.5" cy="4.5" r="1.6"/><path d="M13 4c-3 1-3 4 0 5s3 4 0 5"/>',
        'bag': '<path d="M6 8h12l-1 12H7z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>',
        'zipper': '<rect x="9" y="3" width="6" height="18" rx="2"/><path d="M12 3v18"/><path d="M9 7h6M9 11h6M9 15h6"/>',
        'button': '<circle cx="12" cy="12" r="7"/><circle cx="10" cy="10" r="1"/><circle cx="14" cy="10" r="1"/><circle cx="10" cy="14" r="1"/><circle cx="14" cy="14" r="1"/>',
        'wrench': '<path d="M14 7a4 4 0 1 0 4 4l3 3-3 3-3-3a4 4 0 0 1-4-4z"/><path d="M11 10L4 17l3 3 7-7"/>',
        'clock': '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
        'arrow': '<path d="M5 12h14M13 6l6 6-6 6"/>'
    } %}

    {% set sivankaIconSize = sivankaIconSize|default(22) %}

    {% if sivankaIconPaths[sivankaIcon] is defined %}
        <svg class="sivanka-icon sivanka-icon--{{ sivankaIcon }}"
             width="{{ sivankaIconSize }}" height="{{ sivankaIconSize }}" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="1.6"
             stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true" focusable="false">{{ sivankaIconPaths[sivankaIcon]|raw }}</svg>
    {% endif %}
{% endblock %}
