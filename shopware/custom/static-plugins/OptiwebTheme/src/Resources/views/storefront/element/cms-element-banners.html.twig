{% block element_banners %}
{% set data = element.data %}
{% if data is not empty %}
<section class="cms-element-banners">
    {% if data.sectionTitle %}
        <h2 class="cms-element-title-paragraph cms-element-banners__title">{{ data.sectionTitle }}</h2>
    {% endif %}

    {% set allBanners = data.banners %}

    {# Auto "design mode": when nothing has an explicit style yet, render the design trio
       (image-cta / accent-icon / image-card) in the 3-column layout, using fallback copy.
       As soon as a banner gets a real style in the admin, that style is respected verbatim. #}
    {% set hasExplicitStyle = false %}
    {% for b in allBanners %}
        {% if b.style is defined and b.style not in ['', 'plain'] %}{% set hasExplicitStyle = true %}{% endif %}
    {% endfor %}
    {% set autoMode = not hasExplicitStyle %}

    {% set perRow = autoMode ? 3 : data.perRow|default(3) %}
    {% set banners = autoMode ? allBanners|slice(0, 3) : allBanners %}

    {% set defaultStyles = ['image-cta', 'accent-icon', 'image-card'] %}
    {% set defaults = {
        0: { eyebrow: 'Naše storitve', title: 'Popravila in krajšanje', description: 'Krajšamo hlače in krila, popravljamo šive in obnovimo priljubljene kose.', btnLabel: 'Več o storitvah' },
        1: { title: 'Brezplačna dostava nad 60 €', description: 'Hitra in zanesljiva dostava po vsej Sloveniji.', text: 'Več o dostavi', iconType: 'gift' },
        2: { title: 'Menjava zadrg', description: 'Zamenjamo zadrge na jaknah, hlačah in torbah. Prinesite kos v trgovino.', btnLabel: 'Poglej več' }
    } %}

    <div class="cms-element-banners__grid per-row-{{ perRow }}">
        {% for banner in banners %}
        {% set idx = loop.index0 %}
        {% set def = autoMode and defaults[idx] is defined ? defaults[idx] : {} %}

        {% set style = banner.style|default('plain') %}
        {% if autoMode or style in ['', 'plain'] %}
            {% set style = defaultStyles[idx]|default('image-cta') %}
        {% endif %}

        {# Resolved display fields (banner config wins, design defaults fill the gaps) #}
        {% set bEyebrow = banner.eyebrow ?: (def.eyebrow ?? '') %}
        {% set bTitle   = banner.title ?: (def.title ?? '') %}
        {% set bDesc    = banner.description ?: (def.description ?? '') %}
        {% set bBtn     = banner.btnLabel ?: (def.btnLabel ?? '') %}
        {% set bText    = banner.text ?: (def.text ?? '') %}
        {% set bIcon    = banner.iconType ?: (def.iconType ?? 'gift') %}
        {% set bLink    = banner.link ?: '#' %}
        {% set bBg      = banner.bgColor|default('#F7DCE7') %}

        {% if style == 'image-cta' %}
            {# ---- b1: Image background + gradient + eyebrow + title + desc + button ---- #}
            <a class="sivanka-banner sivanka-banner--image-cta" href="{{ bLink }}">
                {% if banner.media %}
                <div class="sivanka-banner__art">
                    {% sw_thumbnails 'sivanka-banners' with {
                        media: banner.media,
                        sizes: { default: '900px' },
                        attributes: { alt: bTitle|striptags }
                    } %}
                </div>
                {% endif %}
                <div class="sivanka-banner__inner">
                    {% if bEyebrow %}<span class="sivanka-eyebrow">{{ bEyebrow }}</span>{% endif %}
                    {% if bTitle %}<h3>{{ bTitle }}</h3>{% endif %}
                    {% if bDesc %}<p>{{ bDesc }}</p>{% endif %}
                    {% if bBtn %}<span class="sivanka-btn-primary">{{ bBtn }}</span>{% endif %}
                </div>
            </a>

        {% elseif style == 'accent-icon' %}
            {# ---- b2: Accent color background + icon + title + desc + text-link ---- #}
            <div class="sivanka-banner sivanka-banner--accent-icon" style="background: {{ bBg }}">
                <span class="sivanka-banner__icon-box">
                    {% if bIcon == 'truck' %}
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v8H3zM14 9h4l3 3v3h-7z"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg>
                    {% elseif bIcon == 'shield' %}
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
                    {% elseif bIcon == 'star' %}
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    {% elseif bIcon == 'headphones' %}
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 13v-2a8 8 0 0 1 16 0v2"/><rect x="3" y="13" width="4" height="6" rx="1.5"/><rect x="17" y="13" width="4" height="6" rx="1.5"/></svg>
                    {% elseif bIcon == 'heart' %}
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-4.5-9.5-9C1 9 2.5 5.5 6 5.5c2 0 3.2 1.2 4 2.3.8-1.1 2-2.3 4-2.3 3.5 0 5 3.5 3.5 6.5C19 16.5 12 21 12 21Z"/></svg>
                    {% else %}
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11h16v9H4zM4 7h16v4H4zM12 7V4M12 7c-2 0-4-1-4-2.5S10 3 12 7zM12 7c2 0 4-1 4-2.5S14 3 12 7zM12 11v9"/></svg>
                    {% endif %}
                </span>
                {% if bTitle %}<h3>{{ bTitle }}</h3>{% endif %}
                {% if bDesc %}<p>{{ bDesc }}</p>{% endif %}
                {% if bText %}
                <a class="sivanka-banner__text-link" href="{{ bLink }}">
                    {{ bText }}
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" style="width:15px;height:15px"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
                {% endif %}
            </div>

        {% elseif style == 'image-card' %}
            {# ---- b3: Image background + floating card overlay ---- #}
            <a class="sivanka-banner sivanka-banner--image-card" href="{{ bLink }}">
                {% if banner.media %}
                <div class="sivanka-banner__art">
                    {% sw_thumbnails 'sivanka-banners' with {
                        media: banner.media,
                        sizes: { default: '700px' },
                        attributes: { alt: bTitle|striptags }
                    } %}
                </div>
                {% endif %}
                <div class="sivanka-banner__card">
                    {% if bTitle %}<h3>{{ bTitle }}</h3>{% endif %}
                    {% if bDesc %}<p>{{ bDesc }}</p>{% endif %}
                    {% if bBtn %}<span class="sivanka-btn-primary" style="padding: 10px 18px; font-size: 13px;">{{ bBtn }}</span>{% endif %}
                </div>
            </a>

        {% else %}
            {# ---- plain: image + text overlay (legacy/default) ---- #}
            <div class="cms-element-banners__item">
                {% if banner.media %}
                    <a class="cms-element-banners__image" href="{{ bLink }}" aria-label="{{ bTitle|striptags|default(bText|striptags) }}">
                        {% sw_thumbnails 'cms-banners' with {
                            media: banner.media,
                            sizes: { 'xs': '600px', 'sm': '768px', 'md': '1024px', 'lg': '1400px' }
                        } %}
                        {% if banner.text %}
                        {% set posV = banner.textPositionV|default('bottom') %}
                        {% set posH = banner.textPositionH|default('left') %}
                        <div class="cms-element-banners__text pos-v-{{ posV }} pos-h-{{ posH }}">
                            {{ banner.text|raw }}
                        </div>
                        {% endif %}
                    </a>
                {% endif %}
            </div>
        {% endif %}

        {% endfor %}
    </div>
</section>
{% endif %}
{% endblock %}
