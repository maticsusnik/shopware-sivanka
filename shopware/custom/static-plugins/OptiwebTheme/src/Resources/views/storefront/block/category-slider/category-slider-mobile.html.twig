{% set categories = block.slots.getSlot("category").data.get("childCategories") %}

{% block category_slider_mobile %}
    <div class="category-list-container d-flex  flex-column d-md-none">
        {% for category in categories %}
            <div class="category-list-item">
                <a href="{{ category.link }}"
                   class="category-list-link d-flex justify-content-between align-items-center">
                    <div class="category-list-content d-flex">
                        <div class="category-list-icon">
                            {% if category.category_icon.url %}
                                <img src="{{ category.category_icon.url }}" alt="{{ category.category_icon.alt ?? category.name ~
                                ' icon' }}">
                            {% endif %}
                        </div>
                        <div class="content">
                            <h5>{{ category.name }}</h5>
                            <div class="description limit-2-rows">{{ category.short_description|raw }}</div>
                        </div>
                    </div>
                    <div class="category-list-arrow">
                        {% sw_icon 'caret-right' style { pack:'ow'} %}
                    </div>
                </a>
            </div>
        {% endfor %}
    </div>
{% endblock %}
