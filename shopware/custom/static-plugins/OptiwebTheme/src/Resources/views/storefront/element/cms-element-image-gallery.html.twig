{% sw_extends "@Storefront/storefront/element/cms-element-image-gallery.html.twig" %}

{% block element_image_gallery_inner %}

    {% set gallerySliderOptions = gallerySliderOptions|replace_recursive({
        thumbnailSlider: {
            items: 6,
            slideBy: 5,
            controls: true,
            startIndex: startIndexThumbnails ? startIndexThumbnails : null,
            ariaLive: false,
            responsive: {
                xs: {
                    items: 4,
                    slideBy: 3,
                    enabled: true,
                    controls: true
                },
                sm: {
                    items: 4,
                    slideBy: 3,
                    enabled: true,
                    controls: true
                }
            }
        }
    }) %}

    {{ parent() }}

{% endblock %}

{% block element_image_gallery_slider_dots %}{% endblock %}

{% block element_image_gallery_inner_wrapper %}
    {% set product = page.product %}
    <div class="product-badges-icons-wrapper">
        {% block element_image_gallery_badges %}
            {% sw_include '@Storefront/storefront/component/product/card/badges.html.twig' %}
        {% endblock %}
    </div>
    {{ parent() }}
{% endblock %}
