{% sw_extends '@Storefront/storefront/page/checkout/cart/index.html.twig' %}

{# Design has no step indicator on the cart page — just the page title #}
{% block page_checkout_cart_header %}
    <h1 class="cart-main-header">
        {{ 'checkout.cartHeader'|trans|sw_sanitize }}
    </h1>
{% endblock %}

{# Bottom bar under the line items: continue shopping (left) + promo code (right) #}
{% block page_checkout_cart_add_product_and_shipping %}
    <div class="cart-bottom-bar">
        <a href="{{ path('frontend.home.page') }}" class="cart-continue-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
            {{ 'optiweb.checkout.continueShopping'|trans|sw_sanitize }}
        </a>

        <form action="{{ path('frontend.checkout.promotion.add') }}" method="post" class="cart-promo-form">
            <input type="hidden" name="redirectTo" value="frontend.checkout.cart.page">
            <input type="text"
                   name="code"
                   class="cart-promo-input"
                   placeholder="{{ 'optiweb.checkout.promoPlaceholder'|trans|striptags }}"
                   aria-label="{{ 'checkout.addPromotionLabel'|trans|striptags }}"
                   required="required">
            <button type="submit" class="cart-promo-btn">
                {{ 'optiweb.checkout.applyPromo'|trans|sw_sanitize }}
            </button>
        </form>
    </div>
{% endblock %}

{# Pink summary card + proceed button + SSL note + free-shipping card #}
{% block page_checkout_aside_container %}
    <div class="checkout-aside-container sv-summary-card">
        {% block page_checkout_aside_summary %}
            <div class="checkout-aside-summary">
                {% block page_checkout_summary_header %}
                    <h2 class="checkout-aside-summary-header">
                        {{ 'checkout.summaryHeader'|trans|sw_sanitize }}
                    </h2>
                {% endblock %}

                {% block page_checkout_summary_list %}
                    <div class="checkout-aside-summary-list-container">
                        {% block page_checkout_summary_list_container %}
                            {% sw_include '@Storefront/storefront/page/checkout/summary.html.twig' %}
                        {% endblock %}
                    </div>
                {% endblock %}
            </div>
        {% endblock %}

        <a href="{{ path('frontend.checkout.confirm.page') }}"
           class="sv-checkout-btn begin-checkout-btn"
           title="{{ 'checkout.proceedLink'|trans|striptags }}">
            {{ 'optiweb.checkout.toCheckout'|trans|sw_sanitize }}
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>

        <div class="sv-ssl-note">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#2fa36b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
            <span>{{ 'optiweb.checkout.sslSecure'|trans|sw_sanitize }}</span>
        </div>
    </div>

    <div class="sv-freeship-card">
        <span class="sv-freeship-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A02B6B" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v8H3zM14 9h4l3 3v3h-7z"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg>
        </span>
        <div class="sv-freeship-text">{{ 'optiweb.checkout.freeShippingNote'|trans|raw }}</div>
    </div>
{% endblock %}
