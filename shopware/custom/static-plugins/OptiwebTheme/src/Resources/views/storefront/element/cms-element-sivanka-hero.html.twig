{# Home hero — reference/Sivanka Home v2 redesign.dc.html, section 1.

   Full-bleed 520px band: two independently swappable photographs pinned left and
   right at 32% (28 ≤900), each masked so it fades to nothing by the centre. The
   middle of the band is the plain cream surface and the centred copy sits on it
   directly — no overlay over the imagery. A white trust strip overlaps the band's
   bottom edge by 58px (40 ≤900, 28 ≤720).

   Below 720 the right photograph is dropped, the left one fills the band unmasked,
   and the scrim carries a cream veil so the copy stays legible over it. #}
{% block element_sivanka_hero %}
{% set data = element.data %}
{% if data is not empty %}
{% set trustItems = [
    { icon: data.trust1Icon, title: data.trust1Title, sub: data.trust1Sub },
    { icon: data.trust2Icon, title: data.trust2Title, sub: data.trust2Sub },
    { icon: data.trust3Icon, title: data.trust3Title, sub: data.trust3Sub },
    { icon: data.trust4Icon, title: data.trust4Title, sub: data.trust4Sub }
] %}
<section class="sivanka-hero">
    <div class="sivanka-hero__box">
        <div class="sivanka-hero__wash"></div>

        {% if data.imageLeft %}
            <div class="sivanka-hero__photo sivanka-hero__photo--left">
                {% sw_thumbnails 'sivanka-hero-left' with {
                    media: data.imageLeft,
                    sizes: { default: '700px' },
                    attributes: { alt: data.imageLeft.translated.alt ?: '' }
                } %}
            </div>
        {% endif %}

        {% if data.imageRight %}
            <div class="sivanka-hero__photo sivanka-hero__photo--right">
                {% sw_thumbnails 'sivanka-hero-right' with {
                    media: data.imageRight,
                    sizes: { default: '700px' },
                    attributes: { alt: data.imageRight.translated.alt ?: '' }
                } %}
            </div>
        {% endif %}

        <div class="sivanka-hero__scrim"></div>

        <div class="sivanka-hero__text">
            {% if data.headline %}
                <h1 class="sivanka-hero__headline">{{ data.headline|nl2br }}</h1>
            {% endif %}

            {% if data.subheadline %}
                <p class="sivanka-hero__lead">{{ data.subheadline }}</p>
            {% endif %}

            {% if data.primaryBtnLabel or data.secondaryBtnLabel %}
                <div class="sivanka-hero__cta">
                    {% if data.primaryBtnLabel %}
                        <a class="sv-btn sv-btn--lg sv-btn--primary" href="{{ data.primaryBtnUrl ?: '#' }}">{{ data.primaryBtnLabel }}</a>
                    {% endif %}
                    {% if data.secondaryBtnLabel %}
                        <a class="sv-btn sv-btn--lg sv-btn--ghost" href="{{ data.secondaryBtnUrl ?: '#' }}">{{ data.secondaryBtnLabel }}</a>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>

    {% if data.trust1Title or data.trust2Title or data.trust3Title or data.trust4Title %}
        <div class="sivanka-hero__trustwrap">
            <div class="sivanka-trust">
                {% for item in trustItems %}
                    {% if item.title %}
                        <div class="sivanka-trust__item">
                            <span class="sivanka-trust__medallion">
                                {% sw_include '@Storefront/storefront/utilities/sivanka-icon.html.twig' with {
                                    sivankaIcon: item.icon,
                                    sivankaIconSize: 28,
                                    sivankaIconStroke: 1.5
                                } only %}
                            </span>
                            <span class="sivanka-trust__body">
                                <b class="sivanka-trust__title">{{ item.title }}</b>
                                {% if item.sub %}<span class="sivanka-trust__sub">{{ item.sub }}</span>{% endif %}
                            </span>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    {% endif %}
</section>
{% endif %}
{% endblock %}
