{% set products = element.data.products.elements  %}

{% set productSliderOptions = {
    slider: {
        controls: true,
        loop: true,
        Rewind: false,
        nav: false,
        mouseDrag: true,
        autoplay: false,
        speed: 500,
        ariaLive: false,
        autoHeight: false,
        gutter: 16,
        items: 2,
        responsive: {
            xs: {
                items: 2
            },
            sm: {
                items: 2
            },
            md: {
                items: 3
            },
            lg: {
                items: 4
            },
            xl: {
                items: 4
            },
            xxl: {
                items: 4
            }
        }
    }
} %}

{% block producty_slider %}
    <div
            class="product-slider d-block "
            data-base-slider="true"
            data-base-slider-options='{{ productSliderOptions|json_encode }}'
            role="region"
            aria-label="PRoduct slider"
            tabindex="0">

        {% sw_include '@Storefront/storefront/component/skip-target.html.twig' with {
            targetId: block.id,
            snippet: 'component.cms.imageGallery.skipImageGallery',
        } %}

        {% block element_image_slider_controls %}
            <div class="product-slider-controls-container">
                <div class="product-slider-controls" data-base-slider-controls="true">
                    <button class="product-slider-controls-prev image-slider-controls-prev" aria-label="{{ 'general.previous'|trans|striptags }}">
                        {% sw_icon 'arrow-left' style { pack: 'ow'} %}
                    </button>
                    <button class="product-slider-controls-next image-slider-controls-next" aria-label="{{ 'general.next'|trans|striptags }}">
                        {% sw_icon 'arrow-right' style { pack: 'ow'} %}
                    </button>
                </div>
            </div>
        {% endblock %}

        <div class="product-slider-container" data-base-slider-container="true">
            {% for product in products %}
                <div class="product-slider-item">
                    {% sw_include '@Storefront/storefront/component/product/card/box.html.twig' with {
                        'layout': 'standard',
                        'displayMode': 'cover',
                    } %}
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}

