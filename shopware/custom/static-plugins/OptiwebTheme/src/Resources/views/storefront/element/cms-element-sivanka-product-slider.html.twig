{# Product rail — reference/Sivanka Home v2 redesign.dc.html, "Pravkar prišlo" and
   "Najbolj priljubljeno". Native horizontal scroller with a fixed 330px card
   (250 / 224 / 208 as the page narrows). #}
{% block producty_slider %}
    {% set products = element.data.products.elements %}

    {# The reference stamps one badge across a whole rail — "Novo" on "Pravkar prišlo",
       "Priljubljeno" on "Najbolj priljubljeno". It is a property of the rail, not of
       the product, so it is configured on the element. #}
    {% set sliderBadge = element.fieldConfig.elements.badge.value|default('') %}

    <div class="sv-rail sv-rail--products"
         data-sv-rail="true"
         role="region"
         aria-label="{{ element.fieldConfig.elements.title.value.text|default('')|striptags }}">

        {% sw_include '@Storefront/storefront/component/skip-target.html.twig' with {
            targetId: block.id,
            snippet: 'component.cms.imageGallery.skipImageGallery',
        } %}

        <div class="sv-rail__track" tabindex="0">
            {% for product in products %}
                <div class="sv-rail__item">
                    {% sw_include '@Storefront/storefront/component/product/card/box.html.twig' with {
                        'layout': 'standard',
                        'displayMode': 'cover',
                        'sliderBadge': sliderBadge,
                    } %}
                </div>
            {% endfor %}
        </div>

        {% sw_include '@Storefront/storefront/utilities/sivanka-rail-controls.html.twig' %}
    </div>
{% endblock %}
