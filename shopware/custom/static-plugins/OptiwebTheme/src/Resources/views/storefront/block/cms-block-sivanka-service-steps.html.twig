{% block block_sivanka_service_steps %}
    <div class="col-12 cms-block-sivanka-service-steps">
        <div class="sivanka-service-steps">
            <div class="sivanka-service-steps__inner">
                {% sw_include '@Storefront/storefront/block/sivanka-service/slot.html.twig' with {
                    slotName: 'heading',
                    slotClass: 'sivanka-service__heading'
                } %}

                <div class="sivanka-service-steps__grid">
                    {% for slotName in ['stepOne', 'stepTwo', 'stepThree'] %}
                        {% sw_include '@Storefront/storefront/block/sivanka-service/slot.html.twig' with {
                            slotName: slotName,
                            slotClass: 'sivanka-service-steps__item'
                        } %}
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
