{% sw_extends '@Storefront/storefront/component/product/card/box-standard.html.twig' %}

{# Match the design .prod card: image, name, price, add-to-cart button only #}

{% block component_product_box %}
    {% set displayMode = 'cover' %}
    {{ parent() }}
{% endblock %}

{# The reference draws the badge INSIDE the image frame, 10px from its top-left
   corner. Core renders it as a sibling of the frame, so it lands on the card corner
   instead — move it into the frame, which is the positioned box. #}
{% block component_product_box_badges %}{% endblock %}

{# Core makes the card clickable with a `.stretched-link` on the product NAME. Its
   overlay loses to the image frame over part of the picture, so the lower third of
   every tile swallowed the click. Giving the picture its own link is stacking-proof
   and is what a shopper expects anyway. `tabindex=-1` + `aria-hidden` keep it out of
   the tab order and off the accessibility tree — the name link is still the one
   labelled link for the product, so this adds no duplicate stop for keyboard or SR. #}
{% block component_product_box_image_inner %}
    <a href="{{ seoUrl('frontend.detail.page', { productId: product.id }) }}"
       class="product-image-link"
       tabindex="-1"
       aria-hidden="true">
        {{ parent() }}
    </a>
    {% sw_include '@Storefront/storefront/component/product/card/badges.html.twig' %}
{% endblock %}

{% block component_product_box_rating %}{% endblock %}

{% block component_product_box_variant_characteristics %}{% endblock %}

{% block component_product_box_description %}{% endblock %}
