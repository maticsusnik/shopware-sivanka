{% sw_extends "@Storefront/storefront/page/content/index.html.twig" %}

{% block cms_content %}
    <div class="cms-page">
        {% block page_content_blocks %}
            {{ parent() }}
        {% endblock %}
    </div>
    {% block javascript_transaltions %}
        <script>
            window.translations = {
                show: '{{ 'optiweb.showMore'|trans }}',
                hide: '{{ 'optiweb.showLess'|trans }}'
            };
        </script>
    {% endblock %}
{% endblock %}

{% block base_main_inner %}
    {% set cmsPage = page.landingPage ? page.landingPage.cmsPage : page.cmsPage %}
    {% set cmsPageClasses = cmsPage.cssClass|striptags|trim %}
    {% set landingPage = page.landingPage ? page.landingPage : {} %}
    <div class="container-main {{ cmsPageClasses }}">
        {% block page_content %}
            {{ parent() }}
        {% endblock %}
    </div>
{% endblock %}