{% sw_extends '@Storefront/storefront/layout/navbar/navbar.html.twig' %}

{% block layout_navbar_menu_home %}{% endblock %}

{% block layout_navbar_menu_items %}
    {% for treeItem in header.navigation.tree %}

        {% set category = treeItem.category %}
        {% set id = category.id %}
        {% set name = category.translated.name %}
        {% set hasChildren = treeItem.children|length > 0 %}

        {% set isMegaMenu = false %}
        {% set megaMenuClass = "" %}

        {% if loop.index == 1 %}
            {% set isMegaMenu = true %}
            {% set megaMenuClass = "ow-mega-menu" %}
        {% endif %}

        {% block layout_navbar_menu_item %}
            {% if category.type == 'folder' %}
                <li class="nav-item nav-item-{{ id }} {% if isMegaMenu %}{{ megaMenuClass }}{% endif %}" {% if isMegaMenu %}data-{{ megaMenuClass }}="true"{% endif %}>
                    {% if isMegaMenu %}
                        <div class="nav-link nav-item-{{ id }}-link root main-navigation-link p-2{% if hasChildren %} dropdown-toggle{% endif %}">
                            <span itemprop="name" class="main-navigation-link-text">{{ name }} {% if hasChildren %}{% sw_icon 'expand' style { pack: 'ow', size: 'xs'} %}{% endif %}</span>
                        </div>
                    {% else %}
                        <a class="nav-link nav-item-{{ id }}-link root main-navigation-link p-2{% if hasChildren %} dropdown-toggle{% endif %}"
                           href="#"
                           {% if hasChildren %}data-bs-toggle="dropdown"{% endif %}
                           data-flyout-menu-trigger="{{ id }}"
                           itemprop="url"
                           title="{{ name }}">
                            <span itemprop="name" class="main-navigation-link-text">{{ name }} {% if hasChildren %}{% sw_icon 'expand' style { pack: 'ow', size: 'xs'} %}{% endif %}</span>
                        </a>
                    {% endif %}


                    {% if hasChildren %}
                        <div class="dropdown-menu w-100 p-4">
                            {% sw_include '@Storefront/storefront/layout/navbar/content.html.twig' with {
                                themeIconConfig: themeIconConfig,
                                navigationTree: treeItem,
                                level: level+1,
                                page: page
                            } only %}
                        </div>
                    {% endif %}
                </li>
            {% else %}
                <li class="nav-item nav-item-{{ id }} {% if hasChildren %}dropdown position-static{% endif %} {% if isMegaMenu %}{{ megaMenuClass }}{% endif %}" {% if isMegaMenu %}data-{{ megaMenuClass }}="true"{% endif %}>

                    {% if isMegaMenu %}
                        <div class="nav-link nav-item-{{ id }}-link root main-navigation-link p-2 mega-menu-link {% if hasChildren %} dropdown-toggle{% endif %}">
                            {% sw_icon 'nav-button' style { pack: 'ow', size: 'xs'} %}
                            <span itemprop="name" class="main-navigation-link-text">{{ name }}</span>
                        </div>
                    {% else %}
                        <a class="nav-link nav-item-{{ id }}-link root main-navigation-link p-2{% if hasChildren %} dropdown-toggle{% endif %}"
                           href="{{ seoUrl('frontend.navigation.page', { navigationId: id }) }}"
                           {% if hasChildren %}data-bs-toggle="dropdown"{% endif %}
                                {% if category_linknewtab(category) %}target="_blank"{% endif %}
                           itemprop="url"
                           title="{{ name }}">
                            <span itemprop="name" class="main-navigation-link-text">{{ name }} {% if hasChildren %}{% sw_icon 'expand' style { pack: 'ow', size: 'xs'} %}{% endif %}</span>
                        </a>
                    {% endif %}

                    {% if hasChildren %}
                        <div class="dropdown-menu w-100 p-4">
                            {% sw_include '@Storefront/storefront/layout/navbar/content.html.twig' with {
                                themeIconConfig: themeIconConfig,
                                navigationTree: treeItem,
                                level: level+1,
                                page: page
                            } only %}
                        </div>
                    {% endif %}
                </li>
            {% endif %}
        {% endblock %}
    {% endfor %}
{% endblock %}
