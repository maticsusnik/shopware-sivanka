{% sw_extends '@Storefront/storefront/layout/navbar/navbar.html.twig' %}

{# The v2 reference keeps the category bar on screen at every width down to 340px,
   scrolling it horizontally rather than collapsing it behind a hamburger. Core's
   `navbar-expand-lg` + `.collapse` does the opposite, so the wrapper is restated
   here as always-expanded; layout/_main-navigation.scss adds the scroll. #}
{% block layout_navbar_nav_element %}
    <nav class="navbar navbar-expand main-navigation-menu"
         id="main-navigation-menu"
         {# @deprecated tag:v6.8.0 - SiteNavigationElement microdata removed in core (not a rich result) #}
         {% if not feature('JSON_LD_DATA') %}
         itemscope="itemscope"
         itemtype="https://schema.org/SiteNavigationElement"
         {% endif %}
         data-navbar="true"
         {# navbarOptions.pathIdList is deprecated (core now reads window.activeNavigationPathIdList, set in layout/meta) #}
         data-navbar-options="{{ (navbarOptions ?? {})|json_encode }}"
         aria-label="{{ 'header.navigationAriaLabel'|trans|striptags }}">
        <div class="navbar-collapse" id="main_nav">
            <ul class="navbar-nav main-navigation-menu-list">
                {{ block('layout_navbar_menu_home') }}
                {{ block('layout_navbar_menu_items') }}
            </ul>
        </div>
    </nav>
{% endblock %}

{% block layout_navbar_menu_home %}{% endblock %}

{% block layout_navbar_menu_items %}
    {% for treeItem in header.navigation.tree %}

        {% set category = treeItem.category %}
        {% set id = category.id %}
        {% set name = category.translated.name %}
        {% set hasChildren = treeItem.children|length > 0 %}
        {# Like core: folders without children have nothing to open, so they are not rendered #}
        {% set itemSkipped = category.type == 'folder' and not hasChildren %}

        {% set isMegaMenu = false %}
        {% set megaMenuClass = "" %}

        {% if loop.index == 1 %}
            {% set isMegaMenu = true %}
            {% set megaMenuClass = "ow-mega-menu" %}
        {% endif %}

        {% block layout_navbar_menu_item %}
            {% if itemSkipped %}
                {# empty folder — skipped #}
            {% elseif category.type == 'folder' %}
                <li class="nav-item nav-item-{{ id }} {% if isMegaMenu %}{{ megaMenuClass }}{% endif %}" {% if isMegaMenu %}data-{{ megaMenuClass }}="true"{% endif %}>
                    {% if isMegaMenu %}
                        <div class="nav-link nav-item-{{ id }}-link root main-navigation-link p-2 sv-nav-opener sv-nav-opener--desktop{% if hasChildren %} dropdown-toggle{% endif %}">
                            <span {% if not feature('JSON_LD_DATA') %}itemprop="name" {% endif %}class="main-navigation-link-text">{{ name }} {% if hasChildren %}{% sw_icon 'expand' style { pack: 'ow', size: 'xs'} %}{% endif %}</span>
                        </div>
                        {% sw_include '@Storefront/storefront/layout/navbar/menu-trigger.html.twig' with { label: name } only %}
                    {% else %}
                        <a class="nav-link nav-item-{{ id }}-link root main-navigation-link p-2{% if hasChildren %} dropdown-toggle{% else %} no-dropdown{% endif %}"
                           href="#"
                           {% if hasChildren %}data-bs-toggle="dropdown"{% endif %}
                           data-flyout-menu-trigger="{{ id }}"
                           {% if not feature('JSON_LD_DATA') %}itemprop="url"{% endif %}
                           title="{{ name }}">
                            <span {% if not feature('JSON_LD_DATA') %}itemprop="name" {% endif %}class="main-navigation-link-text">{{ name }} {% if hasChildren %}{% sw_icon 'expand' style { pack: 'ow', size: 'xs'} %}{% endif %}</span>
                        </a>
                    {% endif %}


                    {% if hasChildren %}
                        <div class="dropdown-menu w-100 p-4">
                            {% sw_include '@Storefront/storefront/layout/navbar/content.html.twig' with {
                                themeIconConfig: themeIconConfig,
                                navigationTree: treeItem,
                                level: level+1,
                                page: page
                            } only %}
                        </div>
                    {% endif %}
                </li>
            {% else %}
                <li class="nav-item nav-item-{{ id }} {% if hasChildren %}dropdown position-static{% endif %} {% if isMegaMenu %}{{ megaMenuClass }}{% endif %}" {% if isMegaMenu %}data-{{ megaMenuClass }}="true"{% endif %}>

                    {% if isMegaMenu %}
                        <div class="nav-link nav-item-{{ id }}-link root main-navigation-link p-2 mega-menu-link sv-nav-opener sv-nav-opener--desktop{% if hasChildren %} dropdown-toggle{% endif %}">
                            {% sw_icon 'nav-button' style { pack: 'ow', size: 'xs'} %}
                            <span {% if not feature('JSON_LD_DATA') %}itemprop="name" {% endif %}class="main-navigation-link-text">{{ name }}</span>
                        </div>
                        {% sw_include '@Storefront/storefront/layout/navbar/menu-trigger.html.twig' with { label: name } only %}
                    {% else %}
                        <a class="nav-link nav-item-{{ id }}-link root main-navigation-link p-2{% if hasChildren %} dropdown-toggle{% else %} no-dropdown{% endif %}"
                           href="{{ category.seoUrl ?: '#' }}"
                           {% if hasChildren %}data-bs-toggle="dropdown"{% endif %}
                           {% if category.shouldOpenInNewTab %}target="_blank"{% endif %}
                           {% if not feature('JSON_LD_DATA') %}itemprop="url"{% endif %}
                           title="{{ name }}">
                            <span {% if not feature('JSON_LD_DATA') %}itemprop="name" {% endif %}class="main-navigation-link-text">{{ name }} {% if hasChildren %}{% sw_icon 'expand' style { pack: 'ow', size: 'xs'} %}{% endif %}</span>
                        </a>
                    {% endif %}

                    {% if hasChildren %}
                        <div class="dropdown-menu w-100 p-4">
                            {% sw_include '@Storefront/storefront/layout/navbar/content.html.twig' with {
                                themeIconConfig: themeIconConfig,
                                navigationTree: treeItem,
                                level: level+1,
                                page: page
                            } only %}
                        </div>
                    {% endif %}
                </li>
            {% endif %}
        {% endblock %}
    {% endfor %}
{% endblock %}
