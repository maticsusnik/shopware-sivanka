{% sw_extends '@Storefront/storefront/layout/footer.html.twig' %}

{% block base_footer %}
{# ---- Local service strip (outside <footer> but loads with it) ----
   reference/Sivanka Storitve.dc.html, the section directly above <footer>.

   The cream surface *is* the strip: no inner card, no border around the items and
   no shadow — that treatment belongs to the home hero trust row, which is its
   inverse (a white card on the page ground, cream medallions). Here the medallions
   are white on cream and the columns are separated by hairlines only. #}
<section class="sivanka-newsletter-strip">
    <div class="container">
        <div class="nl-svc-grid">
            <div class="nl-svc">
                <span class="nl-svc-ic">
                    <svg class="icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                        <path d="M4 9h16v11H4z"/><path d="M3 9l2-4h14l2 4"/><path d="M9 20v-6h6v6"/>
                    </svg>
                </span>
                <div class="nl-svc-text">
                    <b>{{ 'sivanka.nlSvc1Title'|trans|default('Obiščite nas v Kranju') }}</b>
                    <span>{{ 'sivanka.nlSvc1Text'|trans|default('Cesta Staneta Žagarja 32') }}</span>
                </div>
            </div>
            <div class="nl-svc">
                <span class="nl-svc-ic">
                    <svg class="icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                        <path d="M6 8h12l-1 12H7z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/><path d="M9.5 13.5l2 2 3.5-3.5"/>
                    </svg>
                </span>
                <div class="nl-svc-text">
                    <b>{{ 'sivanka.nlSvc2Title'|trans|default('Prevzem v trgovini') }}</b>
                    <span>{{ 'sivanka.nlSvc2Text'|trans|default('Naročilo pripravimo isti dan') }}</span>
                </div>
            </div>
            <div class="nl-svc">
                <span class="nl-svc-ic">
                    <svg class="icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                        <circle cx="6" cy="17" r="3"/><circle cx="18" cy="17" r="3"/><path d="M8.5 15L18 4M15.5 15L6 4"/>
                    </svg>
                </span>
                <div class="nl-svc-text">
                    <b>{{ 'sivanka.nlSvc3Title'|trans|default('Šivanje in popravila') }}</b>
                    <span>{{ 'sivanka.nlSvc3Text'|trans|default('Storitve v naši delavnici') }}</span>
                </div>
            </div>
        </div>
    </div>
</section>

{{ parent() }}
{% endblock %}
