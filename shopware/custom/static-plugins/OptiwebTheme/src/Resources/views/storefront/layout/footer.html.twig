{% sw_extends '@Storefront/storefront/layout/footer.html.twig' %}

{% block base_footer %}
{# ---- Local service strip (outside <footer> but loads with it) ---- #}
<section class="sivanka-newsletter-strip">
    <div class="container">
        <div class="nl-svc">
            <span class="nl-svc-ic">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M2.8 9.5 4.5 4.6a1.2 1.2 0 0 1 1.1-.8h12.8a1.2 1.2 0 0 1 1.1.8l1.7 4.9"/><path d="M4.2 9.5V19a1.5 1.5 0 0 0 1.5 1.5h12.6a1.5 1.5 0 0 0 1.5-1.5V9.5"/><path d="M2.8 9.5h18.4"/><path d="M9.2 20.5v-5h5.6v5"/>
                </svg>
            </span>
            <div class="nl-svc-text">
                <b>{{ 'sivanka.nlSvc1Title'|trans|default('Obiščite nas v Kranju') }}</b>
                <span>{{ 'sivanka.nlSvc1Text'|trans|default('Cesta Staneta Žagarja 32') }}</span>
            </div>
        </div>
        <div class="nl-svc">
            <span class="nl-svc-ic">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5.6 8h12.8l.9 11.8a1.4 1.4 0 0 1-1.4 1.5H6.1a1.4 1.4 0 0 1-1.4-1.5Z"/><path d="M8.8 8V6.4a3.2 3.2 0 0 1 6.4 0V8"/><path d="m9.5 14.4 1.9 1.9 3.4-3.4"/>
                </svg>
            </span>
            <div class="nl-svc-text">
                <b>{{ 'sivanka.nlSvc2Title'|trans|default('Prevzem v trgovini') }}</b>
                <span>{{ 'sivanka.nlSvc2Text'|trans|default('Naročilo pripravimo isti dan') }}</span>
            </div>
        </div>
        <div class="nl-svc">
            <span class="nl-svc-ic">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="6" cy="6" r="2.6"/><circle cx="6" cy="18" r="2.6"/><path d="M20 4 8.3 15.7"/><path d="M14.4 14.5 20 20"/><path d="M8.3 8.3 12 12"/>
                </svg>
            </span>
            <div class="nl-svc-text">
                <b>{{ 'sivanka.nlSvc3Title'|trans|default('Šivanje in popravila') }}</b>
                <span>{{ 'sivanka.nlSvc3Text'|trans|default('Storitve v naši delavnici') }}</span>
            </div>
        </div>
    </div>
</section>

{{ parent() }}
{% endblock %}
