{% sw_extends '@Storefront/storefront/layout/footer.html.twig' %}

{% block base_footer %}
{# ---- Newsletter / Service Strip (outside <footer> but loads with it) ---- #}
<section class="sivanka-newsletter-strip">
    <div class="container">
        <div class="nl-svc">
            <span class="nl-svc-ic">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 13v-2a8 8 0 0 1 16 0v2"/><rect x="3" y="13" width="4" height="6" rx="1.5"/><rect x="17" y="13" width="4" height="6" rx="1.5"/><path d="M20 19c0 1.5-1.5 2.5-4 2.5"/>
                </svg>
            </span>
            <div class="nl-svc-text">
                <b>{{ 'sivanka.nlSvc1Title'|trans|default('Vprašanja?') }}</b>
                <span>{{ 'sivanka.nlSvc1Text'|trans|default('Z veseljem vam pomagamo') }}</span>
            </div>
        </div>
        <div class="nl-svc">
            <span class="nl-svc-ic">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 8a9 9 0 0 1 16-3M3 5v3h3"/><path d="M21 16a9 9 0 0 1-16 3M21 19v-3h-3"/>
                </svg>
            </span>
            <div class="nl-svc-text">
                <b>{{ 'sivanka.nlSvc2Title'|trans|default('Vračilo brez skrbi') }}</b>
                <span>{{ 'sivanka.nlSvc2Text'|trans|default('14 dni za vračilo izdelkov') }}</span>
            </div>
        </div>
        <div class="nl-block">
            <span class="nl-title">{{ 'sivanka.nlTitle'|trans|default('Ostanimo v stiku') }}</span>
            <span class="nl-subtitle">{{ 'sivanka.nlSubtitle'|trans|default('Pridobite navdih, nove izdelke in posebne ugodnosti.') }}</span>
            <form class="nl-form" action="#" method="post" onsubmit="return false;">
                <input type="email" placeholder="{{ 'sivanka.nlPlaceholder'|trans|default('Vaš e-naslov') }}" aria-label="{{ 'sivanka.nlPlaceholder'|trans|default('Vaš e-naslov') }}">
                <button type="submit" class="btn-nl-submit">
                    {{ 'sivanka.nlButton'|trans|default('Naroči se') }}
                </button>
            </form>
        </div>
    </div>
</section>

{{ parent() }}
{% endblock %}
