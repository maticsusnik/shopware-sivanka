{% sw_extends '@Storefront/storefront/component/checkout/offcanvas-cart.html.twig' %}

{% block component_offcanvas_cart_header_item_counter %}
{% endblock %}

{% block component_offcanvas_cart_actions %}
    <div class="offcanvas-cart-actions">

        {% if isCartNotEmpty %}
            {% block component_offcanvas_cart_actions_checkout %}
                {% import '@OptiwebTheme/storefront/utilities/sivanka-min-order-value.html.twig' as minOrder %}
                {% if minOrder.belowMinimum(page.cart, context)|trim is not empty %}
                    {# Below the minimum order value: same button, switched off. #}
                    <div class="d-grid">
                        <a href="{{ path('frontend.checkout.confirm.page') }}"
                           class="btn btn-primary begin-checkout-btn mb-2 disabled"
                           aria-disabled="true"
                           tabindex="-1"
                           title="{{ 'checkout.proceedToCheckout'|trans|striptags }}">
                            {{ 'checkout.proceedToCheckout'|trans|sw_sanitize }}
                        </a>
                    </div>
                {% else %}
                    {{ parent() }}
                {% endif %}
            {% endblock %}

            {% block component_offcanvas_cart_actions_cart %}
                {# core gives .begin-checkout-btn mb-2 (6.7.x), so no top margin here #}
                <div class="d-grid">
                    <a href="{{ path('frontend.checkout.cart.page') }}"
                       class="btn btn-outline-secondary"
                       title="{{ 'checkout.proceedToCart'|trans|striptags }}">
                        {{ 'checkout.proceedToCart'|trans|sw_sanitize }}
                    </a>
                </div>
            {% endblock %}
        {% endif %}
    </div>
{% endblock %}