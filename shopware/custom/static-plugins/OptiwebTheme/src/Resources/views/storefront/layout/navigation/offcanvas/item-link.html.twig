{% sw_extends '@Storefront/storefront/layout/navigation/offcanvas/item-link.html.twig' %}


{% set isActive = item.category.id == activeId %}
{% set hasChildren = item.category.visibleChildCount > 0 %}
{% set url = category_url(item.category) %}
{% set name = item.category.translated.name %}
{% set icon = item.category.customFields.categoryIcon %}

{% block layout_navigation_offcanvas_navigation_categories_list_category_item_link %}
    <a class="navigation-offcanvas-link nav-item nav-link{% if isActive %} active{% endif %}{% if hasChildren %} js-navigation-offcanvas-link{% endif %}"
            {% if hasChildren %}
                data-preload-category-id="{{ item.category.id }}"
            {% endif %}
       data-category-level="{{ item.category.level }}"
       href="{{ url }}"
            {% if hasChildren %}
                data-href="{{ path('frontend.menu.offcanvas', {navigationId: item.category.id, itemLevel: item.category.level}) }}"
            {% endif %}
       itemprop="url"
            {% if category_linknewtab(item.category) %}target="_blank"{% endif %}
       title="{{ name }}">
        {% block layout_navigation_offcanvas_navigation_categories_list_category_item_link_text %}
            <span class="navigation-offcanvas-label d-flex align-items-center gap-3">
                {% if item.category.level <= 3 %}
                    <span class="navigation-offcanvas-icon">
                        {% if icon.url %}
                            <img src="{{ icon.url }}" alt="{{ icon.alt ?? category.name ~ ' menu icon' }}">
                        {% endif %}
                    </span>
                {% endif %}
                <span itemprop="name">{{ name }}</span>
            </span>

            {% if hasChildren and item.category.level < 5 %}
                {% block layout_navigation_offcanvas_navigation_categories_list_category_item_link_icon %}
                    <span class="navigation-offcanvas-link-icon js-navigation-offcanvas-loading-icon">
                        {% sw_icon 'caret-right' style { pack:'ow', size:'xs'} %}
                    </span>
                {% endblock %}
            {% endif %}
        {% endblock %}
    </a>
{% endblock %}
