{% sw_extends "@Storefront/storefront/element/cms-element-buy-box.html.twig" %}

{% block element_buy_box %}
    {% set config = element.fieldConfig.elements %}

    {% set buyBoxOptions = {
        elementId: element.id
    } %}



    {% if element.data.product  %}
        <div class="sticky-buy-box-container position-relative">
            <div class="cms-element-{{ element.type }}{% if config.alignment.value %} has-vertical-alignment{% endif %}"
                 data-sticky-buy-box="true"
                 data-buy-box="true"
                 data-buy-box-options='{{ buyBoxOptions|json_encode }}'>

                {% block element_buy_box_inner %}
                   {{ parent() }}
                {% endblock %}
            </div>
        </div>
    {% endif %}
{% endblock %}
