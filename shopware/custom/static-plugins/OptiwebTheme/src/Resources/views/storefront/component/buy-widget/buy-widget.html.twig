{% sw_extends "@Storefront/storefront/component/buy-widget/buy-widget.html.twig" %}

{% set manufacturer = page.product.manufacturer %}

{% block buy_widget %}
<div class="product-detail-buy{% if elementId %}-{{ elementId }}{% endif %} js-magnifier-zoom-image-container">

    {% block buy_widget_manufacturer_container %}
        {% if manufacturer %}
            {% if manufacturer.link %}
                <a href="{{ manufacturer.link }}"
                class="cms-image-link product-detail-manufacturer-link"
                target="_blank"
                rel="noreferrer noopener"
                title="{{ manufacturer.name }}">
            {% else %}
                <div class="cms-image-link product-detail-manufacturer-link">
            {% endif %}
            {% if manufacturer.media %}
                <div class="cms-image-container">
                    {% sw_thumbnails 'cms-image-thumbnails' with {
                        media: manufacturer.media,
                        sizes: {
                            'default': '100px'
                        },
                        attributes: {
                            class: 'cms-image product-detail-manufacturer-logo',
                            alt: manufacturer.alt,
                            title: manufacturer.name
                        }
                    } %}
                </div>
            {% else %}
                {{ manufacturer.name }}
            {% endif %}

            {% if manufacturer.link %}
                </a>
            {% else %}
                </div>
            {% endif %}
        {% endif %}
    {% endblock %}

    {% block buy_widget_title_container %}
        <div class="product-detail-name-container">
            <h1 class="product-detail-name" itemprop="name">{{ page.product.translated.name }}</h1>
        </div>
    {% endblock %}

    {% block buy_widget_rich_snippets %}
        {{ parent() }}
    {% endblock %}
    {% block buy_widget_ordernumber_container %}
        {{ parent() }}
    {% endblock %}

    {% block buy_widget_short_description_container %}
        {% if page.product.translated.customFields.shortDescription %}
            <div class="product-detail-short-description">
                {{ page.product.translated.customFields.shortDescription|raw }}
            </div>
        {% endif %}
    {% endblock %}

    {# A product with a hidden price publishes no Offer at all: an Offer without a
       `price` is an error in Google's product report, and a price there would leak what
       the page hides. The inner blocks render unchanged, just outside the Offer scope;
       the Offer-only metas in them are guarded below. The untyped `itemscope` catches
       what is left (the availability link from the delivery info) so it does not land on
       the Product, where `availability` is not a valid property. #}
    {% block buy_widget_buy_container %}
        {% if product.customFields._isHidePrice ?? false %}
            <div itemscope>
                {{ block('buy_widget_data') }}
                {{ block('buy_widget_configurator_include') }}
                {{ block('buy_widget_buy_form') }}
            </div>
        {% else %}
            {{ parent() }}
        {% endif %}
    {% endblock %}
    {% if config('core.cart.wishlistEnabled') %}
        {% block buy_widget_wishlist %}
            {{ parent() }}
        {% endblock %}
    {% endif %}
    </div>
{% endblock %}


    {% block buy_widget_buy_form %}
        {% if page.product.active %}
            {# Check if product is marked as not sellable (set by ProductAvailabilitySubscriber) #}
            {% set isNotSellable = page.product.customFields._isNotSellable ?? false %}
            
            {# Show enquiry button if product is not available OR marked as not sellable #}
            {% set showEnquiryButton = (not page.product.available) or isNotSellable %}
            
            <div class="product-detail-form-container">
                {# Only show buy button if product is available and not marked as not sellable #}
                {% if not showEnquiryButton %}
                    {{ parent() }}
                {% endif %}
                {% if showEnquiryButton %}
                    {% block page_product_detail_enquiry_form_container %}{{ parent() }}{% endblock %}
                {% endif %}
            </div>
        {% endif %}
    {% endblock %}

{# The visible price lives in buy-widget-form.html.twig; core's own price block (and
   the `itemprop="price"` meta inside it) is dropped here, which left the Offer without
   a price. Put the meta back — a single price only; tier prices are covered by the
   AggregateOffer low/high metas from `buy_widget_data_rich_snippet_price_range`. #}
{% block buy_widget_price %}
    {% if not (product.customFields._isHidePrice ?? false) and product.calculatedPrices|length <= 1 %}
        {% set price = product.calculatedPrices|length == 1 ? product.calculatedPrices.first : product.calculatedPrice %}
        <meta itemprop="price" content="{{ price.unitPrice }}">
        <link itemprop="itemCondition" href="https://schema.org/NewCondition">
        <div itemprop="seller" itemscope itemtype="https://schema.org/OnlineStore" itemid="{{ url('frontend.home.page') }}#organization">
            <meta itemprop="name" content="{{ config('OptiwebTheme.config.schemaBusinessName')|default(basicConfig.shopName) }}">
        </div>
    {% endif %}
{% endblock %}

{% block buy_widget_data_rich_snippet_url %}
    {% if not (product.customFields._isHidePrice ?? false) %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block buy_widget_data_rich_snippet_price_currency %}
    {% if not (product.customFields._isHidePrice ?? false) %}
        {{ parent() }}
    {% endif %}
{% endblock %}
{% block buy_widget_tax %}{% endblock %}

{# Core still writes lowPrice/highPrice meta for a multi-price product even though the
   visible price container is gone. Hiding a price in the markup but publishing it to
   search engines defeats the point of the flag. #}
{% block buy_widget_data_rich_snippet_price_range %}
    {% if not (product.customFields._isHidePrice ?? false) %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block buy_widget_delivery_informations %}{% endblock %}

