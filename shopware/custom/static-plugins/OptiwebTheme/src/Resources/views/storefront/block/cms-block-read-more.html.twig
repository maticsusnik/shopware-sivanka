{% block block_read_more %}
    {% set element = block.slots.getSlot('content') %}
    {% set columns = 1 %}

    <div class="col-12 description-read-more" data-cms-element-id="{{ element.id }}">
        {% block block_read_more_inner %}
            {% sw_include '@Storefront/storefront/element/cms-element-' ~ element.type ~ '.html.twig' ignore missing %}
        {% endblock %}
    </div>
{% endblock %}
