{# The section signature: two 34x1px bordo rules at 45% opacity flanking a 15px
   bordo heart outline. Home-page section headings are centred and carry it; subpage
   headings are left-aligned and do not.
   Pull it in with `sw_include`, never `import` — Twig's import does not go through
   theme inheritance and the macro would silently render nothing. #}
{% block sivanka_flourish %}
    <div class="sv-flourish" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 20s-7-4.6-7-9.4A3.9 3.9 0 0 1 12 8a3.9 3.9 0 0 1 7 2.6C19 15.4 12 20 12 20z"/>
        </svg>
    </div>
{% endblock %}
