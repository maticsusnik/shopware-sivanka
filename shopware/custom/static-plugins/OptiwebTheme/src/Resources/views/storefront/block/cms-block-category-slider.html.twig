{# Category rail — reference/Sivanka Home v2 redesign.dc.html, "Izberi svojo kategorijo".

   A native horizontal scroller, not a slider: the tile is a fixed 259px (190 / 164 /
   148 as the page narrows) and the track scrolls. See js/sv-rail.plugin.js for why
   the storefront's tiny-slider wrapper cannot express that ladder. #}
{% block block_category_slider %}
    {% set element = block.slots.getSlot('category') %}
    {% set title = element.config.title.value.text %}
    {% set categories = element.data.get('childCategories') %}

    <div class="col-12 category-slider-wrapper">
        <div class="sivanka-sec-head sivanka-sec-head--centred">
            {% if title %}
                <h2 class="cms-element-title-paragraph">{{ title }}</h2>
                {% sw_include '@Storefront/storefront/utilities/sivanka-flourish.html.twig' %}
            {% endif %}
        </div>

        <div class="sv-rail sv-rail--categories"
             data-sv-rail="true"
             role="region"
             aria-label="{{ title }}">
            <div class="sv-rail__track" tabindex="0">
                {% for category in categories %}
                    <div class="sv-rail__item">
                        <a href="{{ category.link }}" class="category-grid__item">
                            <div class="category-grid__img{% if not category.media %} category-grid__img--placeholder{% endif %}">
                                {% if category.media %}
                                    <img src="{{ category.media.url }}" alt="{{ category.name }}" loading="lazy">
                                {% elseif category.category_icon.url %}
                                    <span class="category-grid__badge">
                                        <img src="{{ category.category_icon.url }}"
                                             alt="{{ category.category_icon.alt ?? (category.name ~ ' icon') }}">
                                    </span>
                                {% endif %}
                            </div>
                            <div class="category-grid__name">{{ category.name }}</div>
                        </a>
                    </div>
                {% endfor %}
            </div>

            {% block category_slider_controls %}
                {% sw_include '@Storefront/storefront/utilities/sivanka-rail-controls.html.twig' %}
            {% endblock %}
        </div>
    </div>
{% endblock %}
