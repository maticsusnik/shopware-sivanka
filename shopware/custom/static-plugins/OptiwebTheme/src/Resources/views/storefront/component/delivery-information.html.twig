{% sw_extends '@Storefront/storefront/component/delivery-information.html.twig' %}

{% block component_delivery_information_default %}
    {# @deprecated tag:v6.8.0 - Availability microdata replaced by JSON-LD, gated like core #}
    {% if not feature('JSON_LD_DATA') %}
        <link itemprop="availability" href="https://schema.org/InStock">
    {% endif %}
    <p class="delivery-information delivery-available">
        <span class="delivery-status-indicator bg-success"></span>
        {{ 'optiweb.product.inStock'|trans }}
    </p>
{% endblock %}