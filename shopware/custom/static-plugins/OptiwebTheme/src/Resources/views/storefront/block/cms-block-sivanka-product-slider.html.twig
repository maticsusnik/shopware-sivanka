{% block block_content %}
    {% set element = block.slots.getSlot('products') %}
    {% set title = element.config.title.value.text %}
    {% set leftImage = element.data.leftImage %}
    {% set hasImage = leftImage is not null %}

    <div class="sivanka-product-slider-wrapper container">
        {# Home-page section headings are centred and carry the rule-heart-rule
           flourish — see utilities/sivanka-flourish.html.twig. #}
        {% if title %}
            <div class="sivanka-sec-head sivanka-sec-head--centred">
                <h2 class="cms-element-title-paragraph">{{ title }}</h2>
                {% sw_include '@Storefront/storefront/utilities/sivanka-flourish.html.twig' %}
            </div>
        {% endif %}

        <div class="row g-4 align-items-start">
            {# LEFT: image (col on desktop, full on mobile) #}
            {% if hasImage %}
                <div class="col-12 col-md-3 order-1 order-md-1">
                    <div class="sivanka-product-slider-left-image">
                        {% sw_thumbnails 'cms-product-slider-left-image' with {
                            media: leftImage
                        } %}
                    </div>
                </div>
            {% endif %}

            {# RIGHT: slider (always rendered) #}
            <div class="col-12 {{ hasImage ? 'col-md-9' : 'col-md-12' }} order-2 order-md-2">
                {% sw_include '@Storefront/storefront/element/cms-element-sivanka-product-slider.html.twig' %}
            </div>
        </div>
    </div>
{% endblock %}




