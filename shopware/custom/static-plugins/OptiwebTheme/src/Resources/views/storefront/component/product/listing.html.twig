{% block element_product_listing_pagination_nav_top %}{% endblock %}
{% block element_product_listing_pagination_nav_actions %}
    <div class="cms-element-product-listing-actions row justify-content-between align-items-center">
        {# Below md the two controls stack: Kategorije button, sort button, then the count.
           From md up they sit on one line again with the count on the left. #}
        <div class="col-md-auto listing-result-count order-2 order-md-0">
            <span class="listing-result-count-text">
                {{ 'optiweb.listing.showingBefore'|trans }}
                <strong>{{ searchResult.total }}</strong>
                {{ 'optiweb.listing.showingAfter'|trans }}
            </span>
        </div>

        <div class="col-md-auto order-1 order-md-0">
            {% block element_product_listing_sorting %}
                {% sw_include '@Storefront/storefront/component/sorting.html.twig' with {
                    current: searchResult.sorting,
                    sortings: searchResult.availableSortings
                } %}
            {% endblock %}
        </div>
    </div>
{% endblock %}

