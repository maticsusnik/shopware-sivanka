{% block element_product_listing_wrapper_content %}
    <div class="filter-panel-active-container-wrapper d-flex gap-3 align-items-baseline" style="display:none;">
        <div class="selected-filters-label col-auto d-none d-lg-block">{{ 'optiweb.listing.selectedFilters'|trans }}:</div>
        <div class="filter-panel-active-container"></div>
    </div>

    {{ parent() }}
{% endblock %}

       {% block element_product_listing_col %}
           {% for product in searchResult %}
               <div class="cms-listing-col col-6 {{ listingColumns }}" role="listitem">
                   {% block element_product_listing_box %}
                       {% sw_include '@Storefront/storefront/component/product/card/box.html.twig' with {
                           layout: boxLayout,
                           displayMode: displayMode
                       } %}
                   {% endblock %}
               </div>
           {% endfor %}
       {% endblock %}