{
    "name": "OptiwebTheme",
    "author": "Optiweb",
    "previewMedia": "app/storefront/dist/assets/Optiweb.jpg",
    "views": [
        "@Storefront",
        "@Plugins",
        "@OptiwebTheme"
    ],
    "style": [
        "app/storefront/src/scss/overrides.scss",
        "@Storefront",
        "app/storefront/src/scss/base.scss"
    ],
    "script": [
        "@Storefront",
        "app/storefront/dist/storefront/js/optiweb-theme/optiweb-theme.js"
    ],
    "asset": [
        "@Storefront",
        "app/storefront/src/assets"
    ],
    "iconSets": {
        "ow": "public/assets/images"
    },
    "config": {
        "blocks": {
            "themeColors": {
                "label": {
                    "en-GB": "Sivanka colours",
                    "de-DE": "Sivanka Farben"
                }
            },
            "typography": {
                "label": {
                    "en-GB": "Typography",
                    "de-DE": "Typografie"
                }
            },
            "media": {
                "label": {
                    "en-GB": "Media",
                    "de-DE": "Medien"
                }
            }
        },
        "fields": {
            "sw-color-brand-primary": {
                "label": {
                    "en-GB": "Bordo (primary)"
