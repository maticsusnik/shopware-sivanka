{% block sw_cms_element_image_tab_config %}
    <div class="optiweb-image-tab-config">
        <sw-text-field label="Title" v-model="element.config.title.value">
        </sw-text-field>

        <sw-tabs>
            <sw-tabs-item @click.native="activeTab = index" v-for="(tab, index) in computedTabs" :ref="'tab' + index"
                          :active="index == activeTab">
                Image tab {{ index + 1 }}
            </sw-tabs-item>
        </sw-tabs>
        <div v-for="(tab, index) in computedTabs">
            <div v-if="index === activeTab">

                {% block sw_cms_element_image_config_media_upload %}
                    <sw-cms-mapping-field
                            v-model:config="element.config.tabs.value[index].image"
                            :label="$tc('sw-cms.elements.image.label')"
                            value-types="entity"
                            entity="media"
                    >
                        <sw-media-upload-v2
                                variant="regular"
                                :upload-tag="uploadTag"
                                :source="previewSource(index)"
                                :allow-multi-select="false"
                                :default-folder="cmsPageState.pageEntityName"
                                :caption="$tc('sw-cms.elements.general.config.caption.mediaUpload')"
                                @media-upload-sidebar-open="onOpenMediaModal"
                                @media-upload-remove-image="onImageRemove(index)"
                        />

                    </sw-cms-mapping-field>

                    <sw-upload-listener
                            :upload-tag="uploadTag"
                            auto-upload
                            @media-upload-finish="(item) => onImageUpload(item,index)"
                    />
                {% endblock %}

                {% block sw_cms_element_image_config_media_modal %}
                    <sw-media-modal-v2
                            v-if="mediaModalIsOpen"
                            variant="full"
                            :caption="$tc('sw-cms.elements.general.config.caption.mediaUpload')"
                            :entity-context="cmsPageState.entityName"
                            :allow-multi-select="false"
                            :initial-folder-id="cmsPageState.defaultMediaFolderId"
                            @media-upload-remove-image="onImageRemove(index)"
                            @media-modal-selection-change="(selection) => onSelectionChanges(selection, index)"
                            @modal-close="onCloseModal"
                    />
                {% endblock %}

                <sw-number-field numberType="int" :digits="0" label="Order" :copyable="false"
                                 v-model="element.config.tabs.value[index].order"
                                 :copyableTooltip="false">
                </sw-number-field>

                <div style="padding-top:32px; border-top:1px solid; margin-top:32px" class="remove">
                    <mt-button  variant="critical" @click="removeTab(index)">
                        Remove this image
                    </mt-button>
                </div>
            </div>
        </div>
        <sw-button-group style="margin-top:32px">
            <mt-button variant="primary" @click="createNewTab" >
                Add new image
            </mt-button>
        </sw-button-group>
    </div>
{% endblock %}
