{% block optiweb_notice_bar_index %}
<sw-page class="optiweb-notice-bar-index">

    {% block optiweb_notice_bar_index_smart_bar_header %}
    <template #smart-bar-header>
        <h2>{{ $tc('optiweb-notice-bar.general.title') }}</h2>
    </template>
    {% endblock %}

    {% block optiweb_notice_bar_index_smart_bar_actions %}
    <template #smart-bar-actions>
        <sw-button-process
            v-tooltip="{
                message: $tc('sw-privileges.tooltip.warning'),
                disabled: canEdit,
                showOnDisabledElements: true
            }"
            :is-loading="isLoading"
            :process-success="isSaveSuccessful"
            :disabled="isLoading || !canEdit"
            variant="primary"
            @update:process-success="saveFinish"
            @click="onSave"
        >
            {{ $tc('global.default.save') }}
        </sw-button-process>
    </template>
    {% endblock %}

    {% block optiweb_notice_bar_index_content %}
    <template #content>
        <sw-card-view>
            <template v-if="isLoading">
                <sw-skeleton />
            </template>

            {# v-show, not v-if: sw-system-config drives isLoading itself and would be destroyed mid-load #}
            <sw-system-config
                v-show="!isLoading"
                ref="systemConfig"
                sales-channel-switchable
                domain="OptiwebTheme.noticeBar"
                @loading-changed="onLoadingChanged"
            />
        </sw-card-view>
    </template>
    {% endblock %}
</sw-page>
{% endblock %}
