# Template for ~/sivanka/shared/.env.local on the production host.
# Copy it there by hand, fill in the <...> values on the server, chmod 600.
# Never commit the filled-in file.

APP_ENV=prod
APP_DEBUG=0
APP_URL=https://www.sivanka.com
APP_SECRET=<64 random hex chars: php -r 'echo bin2hex(random_bytes(32));'>
INSTANCE_ID=<32 random hex chars: php -r 'echo bin2hex(random_bytes(16));'>

DATABASE_URL=mysql://<db_user>:<db_password>@localhost:3306/<db_name>

# The account has no Redis running, so production uses Shopware's default
# filesystem cache (per release, in var/cache/prod). REDIS_URL is unused.
SHOPWARE_HTTP_CACHE_ENABLED=1
SHOPWARE_HTTP_DEFAULT_TTL=7200

LOCK_DSN=flock

# PHP on the host runs without HOME, and the admin's extension listing runs Composer
# internally (plugin refresh), which then dies: "The HOME or COMPOSER_HOME environment
# variable must be set". Lives in shared/ so it survives releases; mkdir it once.
COMPOSER_HOME=/home/sivanka/sivanka/shared/var/composer

# cPanel mailbox, e.g. smtp://shop%40sivanka.com:<password>@th19.neoserv.si:465?encryption=ssl
MAILER_DSN=<smtp dsn>

# LiteSpeed talks to PHP directly, there is no reverse proxy in front.
TRUSTED_PROXIES=127.0.0.1

SHOPWARE_ES_ENABLED=0
SHOPWARE_ES_INDEXING_ENABLED=0

LOG_FOLDER=/home/sivanka/sivanka/shared/var/optiweb-logs/

# Admin lives at /administracija instead of /admin (read when the container is built,
# so run cache:clear after changing it).
SHOPWARE_ADMINISTRATION_PATH_NAME=administracija
