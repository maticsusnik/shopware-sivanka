# =============================================================
# | ATTENTION: This file is auto-generated by Ansible.        |
# | Any changes made here will be lost on the next run.       |
# =============================================================

[mysqld]
# Shopware requirements: below these values the DAL silently truncates
# GROUP_CONCAT results and large imports / media blobs fail on packet size.
group_concat_max_len = 320000
max_allowed_packet = 128M

# Single biggest performance lever - should hold the hot part of the dataset.
# Keep it well within the RAM available to this container: MariaDB refuses to
# start when it cannot allocate the pool.
innodb_buffer_pool_size = 512M
innodb_log_file_size = 512M
innodb_flush_method = O_DIRECT
